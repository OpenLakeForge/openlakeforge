# AWS EKS foundation — account-specific configuration TEMPLATE.
#
# Copy this file to `sandbox.tfvars` (same directory) and fill in your own values,
# then deploy the foundation (olf picks it up automatically via -var-file):
#
#     # from the repository root, so `uv run --project tools/olf` resolves:
#     cp infra/terraform/foundations/aws-eks/sandbox.tfvars.example infra/terraform/foundations/aws-eks/sandbox.tfvars
#     uv run --project tools/olf --locked olf infra deploy --provider aws --phase foundation
#
# `sandbox.tfvars` is gitignored so your account details never land in the repo.
# Override the path with AWS_TFVARS_FILE=/path/to/your.tfvars if you prefer.
# See docs/guides/cloud/deploy-to-aws.md for the full walkthrough.

# NOTE: the cluster name is NOT set here. It comes from the AWS_CLUSTER_NAME
# environment variable (default `eks-openlakeforge`, or the name an existing
# foundation already records) so it stays in sync with the kube context and kubeconfig
# alias the tooling derives from it. Set AWS_CLUSTER_NAME to change it; a value put
# here would be overridden by the -var olf passes.

# Tags applied to every resource. Many managed accounts REQUIRE a specific set of
# tags (case-sensitive) and delete untagged resources. Adjust keys/values to match
# your account policy; Owner/Requester should be YOUR email.
default_tags = {
  Project   = "openlakeforge"
  Owner     = "you@example.com"
  Requester = "you@example.com"
  Env       = "POC"
  IaC       = "Terraform"
}
