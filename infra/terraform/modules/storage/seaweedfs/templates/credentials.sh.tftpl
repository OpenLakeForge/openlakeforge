rand() { tr -dc 'A-Za-z0-9' </dev/urandom | head -c 40; }
hex() { tr -dc 'a-f0-9' </dev/urandom | head -c 16; }

# Assigned first so a failed read stops the script: an empty value here would
# mint a new key and rotate one that consumers already hold.
read_key() {
  value=$(kubectl get secret "$2" -n "$1" --ignore-not-found \
    -o 'go-template={{with index .data "'"$3"'"}}{{.}}{{end}}')
  printf %s "$value" | base64 -d
}

# One key pair in every namespace that runs a consumer: a Secret cannot be read
# across namespaces. The first namespace is the source; an existing Secret is
# kept as is, so a redeploy rotates nothing.
pair() {
  name=$1; shift
  id=$(read_key "$1" "$name" AWS_ACCESS_KEY_ID)
  secret=$(read_key "$1" "$name" AWS_SECRET_ACCESS_KEY)
  [ -n "$id" ] && [ -n "$secret" ] || { id=olf$(hex); secret=$(rand); }
  for ns in "$@"; do
    if kubectl get secret "$name" -n "$ns" >/dev/null 2>&1; then
      echo "Secret $name exists in $ns; keeping it"
    else
      kubectl create secret generic "$name" -n "$ns" \
        --from-literal=AWS_ACCESS_KEY_ID="$id" --from-literal=AWS_SECRET_ACCESS_KEY="$secret" >/dev/null
      echo "Created Secret $name in $ns"
    fi
  done
}

pair ${admin_secret} ${admin_namespaces}
for entry in ${stages}; do
  pair "$${entry%%=*}" "$${entry#*=}"
done

# seaweedfs-s3-auth: every identity with its keys and grants, in the shape the
# chart reads through existingConfigSecret. Keys come from the Secrets above, so
# the config always matches what the consumers hold.
identities='${identities}'
config='{"identities":[]}'
count=$(printf %s "$identities" | jq length)
i=0
while [ "$i" -lt "$count" ]; do
  item=$(printf %s "$identities" | jq -c ".[$i]")
  name=$(printf %s "$item" | jq -r .secret)
  ns=$(printf %s "$item" | jq -r .namespace)
  id=$(read_key "$ns" "$name" AWS_ACCESS_KEY_ID)
  secret=$(read_key "$ns" "$name" AWS_SECRET_ACCESS_KEY)
  config=$(printf %s "$config" | jq -c --argjson item "$item" --arg id "$id" --arg secret "$secret" \
    '.identities += [{name: $item.name, credentials: [{accessKey: $id, secretKey: $secret}], actions: $item.actions}]')
  i=$((i + 1))
done

if kubectl get secret ${auth_secret} -n ${namespace} >/dev/null 2>&1; then
  kubectl patch secret ${auth_secret} -n ${namespace} \
    -p "$(jq -cn --arg config "$config" '{stringData: {seaweedfs_s3_config: $config}}')" >/dev/null
else
  kubectl create secret generic ${auth_secret} -n ${namespace} --from-literal=seaweedfs_s3_config="$config" >/dev/null
fi
echo "Wrote Secret ${auth_secret} with $count identities"

# The gateway reads the config only at startup. A changed config changes the pod
# template, which rolls it. On a fresh install the Deployment does not exist yet
# and starts with the config.
if [ -n "$(kubectl get deployment ${s3_deployment} -n ${namespace} --ignore-not-found -o name)" ]; then
  hash=$(printf %s "$config" | sha256sum | cut -d' ' -f1)
  kubectl patch deployment ${s3_deployment} -n ${namespace} -p "$(jq -cn --arg hash "$hash" \
    '{spec: {template: {metadata: {annotations: {"openlakeforge.io/s3-config-hash": $hash}}}}}')" >/dev/null
fi
