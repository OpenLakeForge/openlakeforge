#!/bin/sh
set -eu

PGPASSWORD="$(cat /master/password)"
export PGPASSWORD

until PGPASSWORD="$PGPASSWORD" psql -h "$PGHOST" -p "$PGPORT" -U "$POSTGRES_USER" -d postgres -c "select 1" >/dev/null 2>&1; do
  sleep 5
done

create_role_and_db() {
  db_name="$1"
  db_user="$2"
  db_password="$3"

  PGPASSWORD="$PGPASSWORD" psql -h "$PGHOST" -p "$PGPORT" -U "$POSTGRES_USER" -d postgres \
    --set=db_name="$db_name" \
    --set=db_user="$db_user" \
    --set=db_password="$db_password" <<'SQL'
  SELECT format('CREATE ROLE %I LOGIN PASSWORD %L', :'db_user', :'db_password')
  WHERE NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = :'db_user')\gexec
  SELECT format('ALTER ROLE %I WITH LOGIN PASSWORD %L', :'db_user', :'db_password')\gexec
  SELECT format('CREATE DATABASE %I OWNER %I', :'db_name', :'db_user')
  WHERE NOT EXISTS (SELECT 1 FROM pg_database WHERE datname = :'db_name')\gexec
  -- PostgreSQL grants CONNECT on every new database to PUBLIC by default, so
  -- every other stage's role can otherwise authenticate into this one over
  -- the shared RDS instance. Revoke it and grant back only to the owner -
  -- #225. Not IF-NOT-EXISTS guarded like the statements above: REVOKE/GRANT
  -- are no-ops when already applied, so re-running on every apply is safe.
  SELECT format('REVOKE CONNECT ON DATABASE %I FROM PUBLIC', :'db_name')\gexec
  SELECT format('GRANT CONNECT ON DATABASE %I TO %I', :'db_name', :'db_user')\gexec
SQL
}

%{ for prefix in database_env_prefixes ~}
create_role_and_db "$${${prefix}_NAME}" "$${${prefix}_USER}" "$${${prefix}_PASSWORD}"
%{ endfor ~}
