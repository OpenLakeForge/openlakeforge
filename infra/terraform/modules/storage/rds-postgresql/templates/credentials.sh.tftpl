rand() { tr -dc 'A-Za-z0-9' </dev/urandom | head -c 32; }

# A Secret that already exists is kept as is: redeploy is not rotation, and a
# consumer may already hold the value.
create() {
  ns=$1; name=$2; shift 2
  if kubectl get secret "$name" -n "$ns" >/dev/null 2>&1; then
    echo "Secret $name exists in $ns; keeping it"
  else
    kubectl create secret generic "$name" -n "$ns" "$@" >/dev/null
    echo "Created Secret $name in $ns"
  fi
}

# RDS rotates the master password, so it is read at every run and never stored.
# Not piped: a failed fetch must fail the container, not leave an empty file.
secret=$(aws secretsmanager get-secret-value --region "$AWS_REGION" --secret-id "$MASTER_SECRET_ARN" \
  --query SecretString --output text)
master=$(printf '%s' "$secret" | jq -r .password)
[ -n "$master" ] && [ "$master" != null ] || { echo "RDS master password is empty" >&2; exit 1; }
printf '%s' "$master" >/master/password

# One password per database, copied to every namespace that runs a consumer: a
# Secret cannot be read across namespaces. Any existing copy is the source, so a
# release that kept one only in a consumer namespace (v0.2) keeps its password.
# Key 'postgresql-password' is the Dagster and Superset Helm charts' own
# convention; every database uses it so consumers stay interchangeable.
for entry in ${databases}; do
  name=$${entry%%=*}
  namespaces=$(echo "$${entry#*=}" | tr , ' ')
  password=
  for ns in $namespaces; do
    [ -z "$password" ] || break
    password=$(kubectl get secret "$name" -n "$ns" --ignore-not-found \
      -o 'go-template={{with index .data "postgresql-password"}}{{.}}{{end}}' | base64 -d)
  done
  [ -n "$password" ] || password=$(rand)
  for ns in $namespaces; do
    create "$ns" "$name" --from-literal=postgresql-password="$password"
  done
done
