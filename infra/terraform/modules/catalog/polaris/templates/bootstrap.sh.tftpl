  set -eu

  polaris_url="http://${release_name}:8181"

  request() {
    method="$1"
    path="$2"
    expected_codes="$3"
    data="$${4:-}"

    if [ -n "$data" ]; then
      code="$(curl -sS -o /tmp/polaris-body -w '%%{http_code}' \
        -X "$method" "$polaris_url/api/management/v1$path" \
        -H "Authorization: Bearer $POLARIS_TOKEN" \
        -H "Content-Type: application/json" \
        -d "$data")"
    else
      code="$(curl -sS -o /tmp/polaris-body -w '%%{http_code}' \
        -X "$method" "$polaris_url/api/management/v1$path" \
        -H "Authorization: Bearer $POLARIS_TOKEN" \
        -H "Content-Type: application/json")"
    fi

    POLARIS_RESPONSE_CODE="$code"

    case " $expected_codes " in
      *" $code "*) return 0 ;;
    esac

    echo "Polaris $method $path returned HTTP $code" >&2
    cat /tmp/polaris-body >&2 || true
    exit 1
  }

  token_response=""
  attempt=1
  while [ "$attempt" -le 60 ]; do
    if token_response="$(curl -sf -X POST "$polaris_url/api/catalog/v1/oauth/tokens" \
      -u "$ROOT_CLIENT_ID:$ROOT_CLIENT_SECRET" \
      -d "grant_type=client_credentials" \
      -d "scope=${oauth_scope}")"; then
      break
    fi
    sleep 5
    attempt=$((attempt + 1))
  done

  POLARIS_TOKEN="$(echo "$token_response" | sed -n 's/.*"access_token":"\([^"]*\)".*/\1/p')"

  if [ -z "$POLARIS_TOKEN" ]; then
    echo "Failed to obtain Polaris root token" >&2
    echo "$token_response" >&2
    exit 1
  fi

  # Trino drops tables with purge, and Polaris drops a view only with purge -
  # the REST view DELETE carries no purge flag. Polaris answers either with
  # 403 unless the catalog allows it, so every dbt incremental run after the
  # first failed dropping its `<model>__dbt_tmp` view (#741). A stage
  # catalog's tables and views can only live in its own stage's buckets
  # (`allowedLocations`), so a purge cannot reach another stage's files
  # (ADR 0004).
  drop_with_purge="polaris.config.drop-with-purge.enabled"

%{ for stage_name, stage in stage_catalogs ~}
  request POST "/catalogs" "201 409" "{
    \"name\": \"${stage.catalog_name}\",
    \"type\": \"INTERNAL\",
    \"properties\": {
      \"default-base-location\": \"s3://${stage.silver_bucket_name}/\",
      \"$drop_with_purge\": \"true\"
    },
    \"storageConfigInfo\": {
      \"storageType\": \"S3\",
      \"allowedLocations\": [\"s3://${stage.bronze_bucket_name}/\", \"s3://${stage.silver_bucket_name}/\", \"s3://${stage.gold_bucket_name}/\"],
      \"pathStyleAccess\": true,
%{ if sts != null ~}
      \"roleArn\": \"${sts.role_arn}\",
      \"region\": \"${sts.region}\",
      \"endpoint\": \"${sts.endpoint}\",
      \"stsEndpoint\": \"${sts.sts_endpoint}\",
      \"stsUnavailable\": false
%{ else ~}
      \"stsUnavailable\": true
%{ endif ~}
    }
  }"
  if [ "$POLARIS_RESPONSE_CODE" = "409" ]; then
    request GET "/catalogs/${stage.catalog_name}" "200"
%{ if sts != null ~}
    # Polaris refuses to add a role ARN to an existing catalog, so a catalog
    # created before STS was configured keeps vending nothing (ADR 0019).
    if ! grep -Eq '"stsUnavailable" *: *false' /tmp/polaris-body; then
      echo "Catalog ${stage.catalog_name} was created without STS and vends no credentials; a stack redeployed from scratch gets it." >&2
    fi
%{ endif ~}
    # A catalog created before the property existed lacks it. Polaris
    # replaces the whole property map on update, so the current one is kept.
    if ! jq -e --arg key "$drop_with_purge" '.properties[$key] == "true"' /tmp/polaris-body >/dev/null; then
      request PUT "/catalogs/${stage.catalog_name}" "200" "$(jq -c --arg key "$drop_with_purge" \
        '{currentEntityVersion: .entityVersion, properties: ((.properties // {}) + {($key): "true"})}' /tmp/polaris-body)"
    fi
  fi
%{ endfor ~}

  create_principal_secret() {
    principal_name="$1"
    secret_name="$2"
    client_id_key="$3"
    client_secret_key="$4"
    target_namespace="$5"
    # Stage-scoped identities (Floe, deployer) live in the stage's own
    # namespace, which `--allow-stage-removal` deletes outright and a later
    # re-enable recreates empty - their Polaris principal survives in the
    # relational metastore either way, so "principal exists, namespace has
    # neither Secret nor pending marker" is the expected shape of a stage
    # coming back, not an anomaly. Shared identities (Trino, OpenMetadata)
    # never lose their namespace this way, so the same shape there still
    # means someone deleted an active client's Secret by hand.
    recreatable_on_missing_secret="$${6:-false}"
    pending_name="$secret_name-bootstrap-pending"

    request GET "/principals/$principal_name" "200 404"
    if [ "$POLARIS_RESPONSE_CODE" = "200" ]; then
      if kubectl get configmap "$pending_name" -n "$target_namespace" >/dev/null 2>&1; then
        # A pending marker is written before the first create call. It
        # identifies the otherwise unrecoverable window where Polaris
        # created a principal but Kubernetes did not persist its one-time
        # credentials. It takes precedence over a legacy in-memory
        # Secret, which cannot authenticate to this new principal.
        request POST "/principals/$principal_name/rotate" "200"
      elif kubectl get secret "$secret_name" -n "$target_namespace" >/dev/null 2>&1; then
        return
      elif [ "$recreatable_on_missing_secret" = "true" ]; then
        echo "Polaris principal '$principal_name' exists but '$target_namespace' has no Secret or pending marker; treating this as a removed-then-re-enabled stage and rotating its credentials." >&2
        request POST "/principals/$principal_name/rotate" "200"
      else
        echo "Polaris principal '$principal_name' exists but credential Secret '$secret_name' is missing." >&2
        echo "Restore the Secret before rerunning the bootstrap job to avoid rotating active clients." >&2
        exit 1
      fi
    else
      if ! kubectl get configmap "$pending_name" -n "$target_namespace" >/dev/null 2>&1; then
        kubectl create configmap "$pending_name" \
          -n "$target_namespace" \
          --from-literal="principal=$principal_name"
      fi

      # In-memory Polaris state is intentionally not migrated. Remove
      # the unusable legacy Secret before creating fresh credentials in
      # the relational metastore.
      kubectl delete secret "$secret_name" -n "$target_namespace" --ignore-not-found
      request POST "/principals" "201 409" "{\"name\": \"$principal_name\", \"type\": \"SERVICE\"}"
      if [ "$POLARIS_RESPONSE_CODE" = "409" ]; then
        request POST "/principals/$principal_name/rotate" "200"
      fi
    fi
    client_id="$(sed -n 's/.*"clientId":"\([^"]*\)".*/\1/p' /tmp/polaris-body | head -n 1)"
    client_secret="$(sed -n 's/.*"clientSecret":"\([^"]*\)".*/\1/p' /tmp/polaris-body | head -n 1)"

    if [ -z "$client_id" ] || [ -z "$client_secret" ]; then
      echo "Failed to parse Polaris principal credentials for $principal_name" >&2
      cat /tmp/polaris-body >&2
      exit 1
    fi

    kubectl delete secret "$secret_name" -n "$target_namespace" --ignore-not-found
    kubectl create secret generic "$secret_name" \
      -n "$target_namespace" \
      --from-literal="$client_id_key=$client_id" \
      --from-literal="$client_secret_key=$client_secret"
    kubectl delete configmap "$pending_name" -n "$target_namespace" --ignore-not-found
  }

  # Polaris answers a repeated role assignment or grant with HTTP 500 and a
  # `grant_records_pkey` constraint violation rather than the 409 the create
  # endpoints return, so re-running this job against an already-bootstrapped
  # catalog cannot rely on tolerating a conflict code. Read the current state
  # and only write what is missing; a real 500 still fails the job.
  already_present() {
    path="$1"
    field="$2"
    value="$3"

    # 404 means the collection does not exist yet, which is "not present"
    # rather than a failure. Any other unexpected code still exits the job.
    request GET "$path" "200 404"
    if [ "$POLARIS_RESPONSE_CODE" != "200" ]; then
      return 1
    fi
    grep -qE "\"$field\" *: *\"$value\"" /tmp/polaris-body
  }

  grant_catalog_access() {
    principal_name="$1"
    principal_role="$2"
    catalog_role="$3"
    catalog_privilege="$4"
    catalog_name="$5"

    request POST "/principal-roles" "201 409" "{\"principalRole\": {\"name\": \"$principal_role\"}}"
    if ! already_present "/principals/$principal_name/principal-roles" "name" "$principal_role"; then
      request PUT "/principals/$principal_name/principal-roles" "201 409" "{\"principalRole\": {\"name\": \"$principal_role\"}}"
    fi

    request POST "/catalogs/$${catalog_name}/catalog-roles" "201 409" "{\"catalogRole\": {\"name\": \"$catalog_role\"}}"
    if ! already_present "/catalogs/$${catalog_name}/catalog-roles/$catalog_role/grants" "privilege" "$catalog_privilege"; then
      request PUT "/catalogs/$${catalog_name}/catalog-roles/$catalog_role/grants" "201 409" "{\"grant\": {\"type\": \"catalog\", \"privilege\": \"$catalog_privilege\"}}"
    fi

    if ! already_present "/principal-roles/$principal_role/catalog-roles/$${catalog_name}" "name" "$catalog_role"; then
      request PUT "/principal-roles/$principal_role/catalog-roles/$${catalog_name}" "201 409" "{\"catalogRole\": {\"name\": \"$catalog_role\"}}"
    fi
  }

%{ for stage_name, stage in stage_catalogs ~}
  create_principal_secret "${stage.trino_principal_name}" "${stage.trino_credentials_secret_name}" "POLARIS_TRINO_CLIENT_ID" "POLARIS_TRINO_CLIENT_SECRET" "$NAMESPACE"
  grant_catalog_access "${stage.trino_principal_name}" "${principal_role}-${stage_name}" "${catalog_role}" "CATALOG_MANAGE_CONTENT" "${stage.catalog_name}"

  create_principal_secret "${stage.floe_principal_name}" "${stage.floe_credentials_secret_name}" "POLARIS_FLOE_CLIENT_ID" "POLARIS_FLOE_CLIENT_SECRET" "${stage.namespace}" "true"
  grant_catalog_access "${stage.floe_principal_name}" "${floe_principal_role}-${stage_name}" "${floe_catalog_role}" "CATALOG_MANAGE_CONTENT" "${stage.catalog_name}"
%{ endfor ~}

  # dbt Gold now writes through Trino. Remove credentials created by
  # pre-migration deployments while keeping shared Floe roles intact.
  request DELETE "/principals/dbt" "204 404"
  kubectl delete secret "polaris-dbt-creds" -n "$NAMESPACE" --ignore-not-found

  create_principal_secret "${om_principal_name}" "${om_credentials_secret_name}" "POLARIS_OM_CLIENT_ID" "POLARIS_OM_CLIENT_SECRET" "$NAMESPACE"
%{ for stage_name, stage in stage_catalogs ~}
  grant_catalog_access "${om_principal_name}" "${om_principal_role}" "${om_catalog_role}-${stage_name}" "CATALOG_MANAGE_CONTENT" "${stage.catalog_name}"
%{ endfor ~}

  # Namespace lifecycle belongs to Phase 2 (ADR 0002). Phase 1 stops at
  # handing `olf infra catalog sync-namespaces` a principal that can create
  # and drop namespaces, so no platform apply ever needs to know which
  # products exist.
%{ for stage_name, stage in stage_catalogs ~}
  create_principal_secret "${stage.deployer_principal_name}" "${stage.deployer_credentials_secret_name}" "POLARIS_DEPLOYER_CLIENT_ID" "POLARIS_DEPLOYER_CLIENT_SECRET" "${stage.namespace}" "true"
  grant_catalog_access "${stage.deployer_principal_name}" "${deployer_principal_role}-${stage_name}" "${deployer_catalog_role}" "CATALOG_MANAGE_METADATA" "${stage.catalog_name}"
%{ if person_access_enabled ~}
  # `olf infra catalog sync-namespaces` grants olf-gold-read on each Gold
  # namespace as this principal (ADR 0019, section 5). Without people's access
  # that role does not exist, so the deployer keeps its narrower privilege.
  grant_catalog_access "${stage.deployer_principal_name}" "${deployer_principal_role}-${stage_name}" "${deployer_catalog_role}" "CATALOG_MANAGE_ACCESS" "${stage.catalog_name}"
%{ endif ~}
%{ endfor ~}
