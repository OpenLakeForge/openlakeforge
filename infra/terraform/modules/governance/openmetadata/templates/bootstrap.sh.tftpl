  set -eu

  om_url="${om_url}"
  admin_email="${admin_email}"
  admin_password="${admin_password}"

  # Wait for OpenMetadata to become healthy
  attempt=1
  while [ "$attempt" -le 120 ]; do
    code="$(curl -so /dev/null -w '%%{http_code}' "$om_url/api/v1/system/config/jwks")"
    if [ "$code" = "200" ]; then
      break
    fi
    sleep 5
    attempt=$((attempt + 1))
  done
  if [ "$attempt" -gt 120 ]; then
    echo "OpenMetadata did not become healthy in time" >&2
    exit 1
  fi

  # Login as admin. OpenMetadata Basic Auth expects the password base64-encoded.
  encoded_password="$(printf '%s' "$admin_password" | base64 | tr -d '\n')"
  login_resp="$(curl -sS -X POST "$om_url/api/v1/users/login" \
    -H "Content-Type: application/json" \
    -d "{\"email\":\"$admin_email\",\"password\":\"$encoded_password\"}")"
  ADMIN_JWT="$(echo "$login_resp" | jq -r '.accessToken // empty')"

  if [ -z "$ADMIN_JWT" ]; then
    echo "Failed to obtain admin JWT" >&2
    echo "$login_resp" >&2
    exit 1
  fi

  # Generate an unlimited ingestion-bot JWT token for local machine traffic.
  bot_resp="$(curl -sS "$om_url/api/v1/users/name/ingestion-bot" \
    -H "Authorization: Bearer $ADMIN_JWT")"
  bot_id="$(echo "$bot_resp" | jq -r '.id // empty')"

  if [ -z "$bot_id" ]; then
    echo "Failed to find ingestion-bot user" >&2
    echo "$bot_resp" >&2
    exit 1
  fi

  token_resp="$(curl -sS -X PUT "$om_url/api/v1/users/generateToken/$bot_id" \
    -H "Authorization: Bearer $ADMIN_JWT" \
    -H "Content-Type: application/json" \
    -d "{\"JWTTokenExpiry\":\"Unlimited\"}")"
  token_get_resp="$(curl -sS "$om_url/api/v1/users/token/$bot_id" \
    -H "Authorization: Bearer $ADMIN_JWT")"
  BOT_JWT="$(echo "$token_get_resp" | jq -r '.JWTToken // empty')"

  if [ -z "$BOT_JWT" ]; then
    echo "Failed to obtain ingestion-bot JWT" >&2
    echo "$token_resp" >&2
    echo "$token_get_resp" >&2
    exit 1
  fi
  case "$BOT_JWT" in
    fernet:*)
      echo "OpenMetadata returned an encrypted ingestion-bot token instead of a bearer JWT" >&2
      exit 1
      ;;
  esac

  # OpenMetadata 1.12's Iceberg connector uses PyIceberg 0.5.1, whose
  # client-credentials flow hardcodes an OAuth scope Polaris rejects.
  # Mint the Polaris token here with the correct local scope and store
  # the bearer token in the OpenMetadata service connection.
  catalog_type="${catalog_type}"
  catalog_service="${catalog_service_name}"
  catalog_display="${catalog_service_display_name}"
  catalog_uri="${catalog_uri}"
  catalog_warehouse="${catalog_warehouse}"
  catalog_token=""

  if [ "$catalog_type" = "rest" ]; then
    polaris_token_code="$(curl -sS -o /tmp/polaris-token-body -w '%%{http_code}' \
      -X POST "${token_uri}" \
      -H "Content-Type: application/x-www-form-urlencoded" \
      --data-urlencode "grant_type=client_credentials" \
      --data-urlencode "client_id=$POLARIS_OM_CLIENT_ID" \
      --data-urlencode "client_secret=$POLARIS_OM_CLIENT_SECRET" \
      --data-urlencode "scope=${oauth_scope}")"
    if [ "$polaris_token_code" != "200" ]; then
      echo "Failed to obtain Polaris token for OpenMetadata (HTTP $polaris_token_code)" >&2
      cat /tmp/polaris-token-body >&2
      exit 1
    fi

    catalog_token="$(jq -r '.access_token // empty' /tmp/polaris-token-body)"
    if [ -z "$catalog_token" ]; then
      echo "Failed to parse Polaris token for OpenMetadata" >&2
      cat /tmp/polaris-token-body >&2
      exit 1
    fi
  fi

  # Store bot JWT as Kubernetes Secret
  kubectl delete secret "${ingestion_bot_secret_name}" -n "$NAMESPACE" --ignore-not-found
  kubectl create secret generic "${ingestion_bot_secret_name}" \
    -n "$NAMESPACE" \
    --from-literal="${ingestion_bot_jwt_key}=$BOT_JWT"

  # Enable native OpenLineage ingestion for dbt-trino and Floe. Floe
  # emits accepted Iceberg datasets under the catalog service name
  # (polaris or aws_glue), while dbt-trino uses its Trino URI.
  trino_namespace="${trino_lineage_namespace}"
  lineage_settings="$(jq -n \
    --arg service "$catalog_service" \
    --arg trino "$trino_namespace" \
    --arg pipeline_service "${lineage_pipeline_service}" \
    '{config_type:"openLineageSettings",config_value:{enabled:true,autoCreateEntities:false,eventTypeFilter:["COMPLETE"],defaultPipelineService:$pipeline_service,namespaceToServiceMapping:{($trino):$service,($service):$service}}}')"
  lineage_code="$(curl -sS -o /tmp/om-openlineage-body -w '%%{http_code}' \
    -X PUT "$om_url/api/v1/system/settings" \
    -H "Authorization: Bearer $ADMIN_JWT" \
    -H "Content-Type: application/json" \
    -d "$lineage_settings")"
  case " 200 201 " in
    *" $lineage_code "*) ;;
    *)
      echo "Failed to enable OpenLineage settings (HTTP $lineage_code)" >&2
      cat /tmp/om-openlineage-body >&2
      exit 1
      ;;
  esac

  # Create or update the Iceberg database service in OpenMetadata.
  svc_code="$(curl -sS -o /tmp/om-svc-body -w '%%{http_code}' \
    -X PUT "$om_url/api/v1/services/databaseServices" \
    -H "Authorization: Bearer $ADMIN_JWT" \
    -H "Content-Type: application/json" \
    -d "{
      \"name\": \"$catalog_service\",
      \"displayName\": \"$catalog_display\",
      \"serviceType\": \"Iceberg\",
      \"connection\": {
        \"config\": {
          \"type\": \"Iceberg\",
          \"catalog\": {
            \"name\": \"$catalog_warehouse\",
            \"databaseName\": \"${catalog_database_name}\",
            \"warehouseLocation\": \"$catalog_warehouse\",
            \"connection\": {
              \"uri\": \"$catalog_uri\",
              \"token\": \"$catalog_token\",
              \"fileSystem\": {
                \"type\": {
                  \"awsRegion\": \"${storage_region}\",
                  \"endPointURL\": \"${storage_endpoint}\"
                }
              }
            }
          }
        }
      }
    }")"

  case " 200 201 " in
    *" $svc_code "*) svc_resp="$(cat /tmp/om-svc-body)" ;;
    *)
      echo "Failed to create or update OpenMetadata database service (HTTP $svc_code)" >&2
      cat /tmp/om-svc-body >&2
      exit 1
      ;;
  esac

  svc_id="$(echo "$svc_resp" | jq -r '.id // empty')"

  if [ -z "$svc_id" ]; then
    echo "Failed to retrieve Iceberg service id" >&2
    echo "$svc_resp" >&2
    exit 1
  fi

  # Every governed stage gets its own `<service>.lakehouse_<stage>` database
  # entity: `olf openmetadata deploy-metadata` seeds a stage's schemas and
  # tables under that root (#211) and OpenMetadata rejects a schema whose
  # database does not resolve. Only the canonical stage's catalog is crawled --
  # the Iceberg service above holds one connection.
  printf '%s' "${stages_json_b64}" | base64 -d >/tmp/om-stages.json
  printf '%s' "${catalog_schema_names_json_b64}" | base64 -d >/tmp/om-catalog-schemas.json

  stage_field() {
    jq -r --arg stage "$1" --arg field "$2" '.[$stage][$field] // empty' /tmp/om-stages.json
  }

  ensure_stage_database() {
    database="$1"
    database_fqn="$catalog_service.$database"
    db_payload="$(jq -n --arg name "$database" --arg service "$catalog_service" '{name: $name, service: $service}')"
    db_code="$(curl -sS -o /tmp/om-db-body -w '%%{http_code}' \
      -X PUT "$om_url/api/v1/databases" \
      -H "Authorization: Bearer $ADMIN_JWT" \
      -H "Content-Type: application/json" \
      -d "$db_payload")"
    case " 200 201 " in
      *" $db_code "*) ;;
      *)
        echo "Failed to create or update OpenMetadata database '$database_fqn' (HTTP $db_code)" >&2
        cat /tmp/om-db-body >&2
        exit 1
        ;;
    esac

    for schema_name in $(jq -r '.[]' /tmp/om-catalog-schemas.json); do
      schema_payload="$(jq -n --arg name "$schema_name" --arg database "$database_fqn" '{name: $name, database: $database}')"
      schema_code="$(curl -sS -o /tmp/om-schema-body -w '%%{http_code}' \
        -X PUT "$om_url/api/v1/databaseSchemas" \
        -H "Authorization: Bearer $ADMIN_JWT" \
        -H "Content-Type: application/json" \
        -d "$schema_payload")"
      case " 200 201 " in
        *" $schema_code "*) ;;
        *)
          echo "Failed to create or update OpenMetadata schema '$database_fqn.$schema_name' (HTTP $schema_code)" >&2
          cat /tmp/om-schema-body >&2
          exit 1
          ;;
      esac
    done
  }

  # Upsert a service by name, then create its metadata ingestion pipeline once
  # and deploy it without triggering: the Dagster connector still queries the
  # pre-1.x `PipelineRuns` type, and Superset reports only exist after the
  # artifact phase imports them (ADR 0007).
  # Args: service kind (pipelineServices|dashboardServices), service payload,
  # pipeline name, pipeline display name, source config type, service ref type.
  register_service() {
    kind="$1"
    service_payload="$2"
    pipeline_name="$3"
    pipeline_display="$4"
    source_type="$5"
    service_ref_type="$6"
    service_name="$(echo "$service_payload" | jq -r '.name')"

    svc_code="$(curl -sS -o /tmp/om-stage-svc-body -w '%%{http_code}' \
      -X PUT "$om_url/api/v1/services/$kind" \
      -H "Authorization: Bearer $ADMIN_JWT" \
      -H "Content-Type: application/json" \
      -d "$service_payload")"
    case " 200 201 " in
      *" $svc_code "*) stage_svc_id="$(jq -r '.id // empty' /tmp/om-stage-svc-body)" ;;
      *)
        echo "Failed to create OpenMetadata service '$service_name' (HTTP $svc_code)" >&2
        cat /tmp/om-stage-svc-body >&2
        exit 1
        ;;
    esac

    check_code="$(curl -sS -o /tmp/om-stage-pipeline-body -w '%%{http_code}' \
      "$om_url/api/v1/services/ingestionPipelines/name/$service_name.$pipeline_name" \
      -H "Authorization: Bearer $ADMIN_JWT")"
    if [ "$check_code" = "200" ]; then
      stage_pipeline_id="$(jq -r '.id // empty' /tmp/om-stage-pipeline-body)"
    elif [ "$check_code" = "404" ]; then
      pipeline_payload="$(jq -n \
        --arg name "$pipeline_name" \
        --arg display "$pipeline_display" \
        --arg source_type "$source_type" \
        --arg service_id "$stage_svc_id" \
        --arg service_type "$service_ref_type" \
        '{
          name: $name,
          displayName: $display,
          pipelineType: "metadata",
          sourceConfig: {config: ({type: $source_type} + (if $source_type == "PipelineMetadata" then {includeLineage: true} else {includeDataModels: true} end))},
          airflowConfig: {startDate: "2025-01-01T00:00:00.000Z", retries: 1, pausePipeline: true},
          service: {id: $service_id, type: $service_type}
        }')"
      create_code="$(curl -sS -o /tmp/om-stage-pipeline-body -w '%%{http_code}' \
        -X POST "$om_url/api/v1/services/ingestionPipelines" \
        -H "Authorization: Bearer $ADMIN_JWT" \
        -H "Content-Type: application/json" \
        -d "$pipeline_payload")"
      case " 200 201 " in
        *" $create_code "*) stage_pipeline_id="$(jq -r '.id // empty' /tmp/om-stage-pipeline-body)" ;;
        *)
          echo "Failed to create ingestion pipeline '$service_name.$pipeline_name' (HTTP $create_code)" >&2
          cat /tmp/om-stage-pipeline-body >&2
          exit 1
          ;;
      esac
    else
      echo "Failed to inspect ingestion pipeline '$service_name.$pipeline_name' (HTTP $check_code)" >&2
      exit 1
    fi

    curl -sS -o /tmp/om-stage-deploy-body -X POST \
      "$om_url/api/v1/services/ingestionPipelines/deploy/$stage_pipeline_id" \
      -H "Authorization: Bearer $ADMIN_JWT" || true
    echo "OpenMetadata service '$service_name' registered (ingestion deferred, see ADR 0007)."
  }

  # A stage that lost governance or analytics keeps its namespace, but the
  # service registered for it would point governance at a runtime that no
  # longer reports to it. Look up by name, delete by id, pipeline before the
  # service that owns it -- so the common path issues no delete at all.
  remove_service() {
    kind="$1"
    service_name="$2"
    pipeline_name="$3"

    stale_pipeline_code="$(curl -sS -o /tmp/om-stale-pipeline -w '%%{http_code}' \
      "$om_url/api/v1/services/ingestionPipelines/name/$service_name.$pipeline_name" \
      -H "Authorization: Bearer $ADMIN_JWT")"
    if [ "$stale_pipeline_code" = "200" ]; then
      stale_pipeline_id="$(jq -r '.id // empty' /tmp/om-stale-pipeline)"
      delete_code="$(curl -sS -o /tmp/om-stale-delete -w '%%{http_code}' \
        -X DELETE "$om_url/api/v1/services/ingestionPipelines/$stale_pipeline_id?hardDelete=true" \
        -H "Authorization: Bearer $ADMIN_JWT")"
      case " 200 404 " in
        *" $delete_code "*) ;;
        *)
          echo "Failed to remove stale ingestion pipeline '$service_name.$pipeline_name' (HTTP $delete_code)" >&2
          cat /tmp/om-stale-delete >&2
          exit 1
          ;;
      esac
    elif [ "$stale_pipeline_code" != "404" ]; then
      echo "Failed to inspect ingestion pipeline '$service_name.$pipeline_name' (HTTP $stale_pipeline_code)" >&2
      exit 1
    fi

    stale_svc_code="$(curl -sS -o /tmp/om-stale-svc -w '%%{http_code}' \
      "$om_url/api/v1/services/$kind/name/$service_name" \
      -H "Authorization: Bearer $ADMIN_JWT")"
    if [ "$stale_svc_code" = "200" ]; then
      stale_svc_id="$(jq -r '.id // empty' /tmp/om-stale-svc)"
      delete_code="$(curl -sS -o /tmp/om-stale-delete -w '%%{http_code}' \
        -X DELETE "$om_url/api/v1/services/$kind/$stale_svc_id?hardDelete=true&recursive=true" \
        -H "Authorization: Bearer $ADMIN_JWT")"
      case " 200 404 " in
        *" $delete_code "*) echo "Removed stale OpenMetadata service '$service_name'." ;;
        *)
          echo "Failed to remove stale OpenMetadata service '$service_name' (HTTP $delete_code)" >&2
          cat /tmp/om-stale-delete >&2
          exit 1
          ;;
      esac
    elif [ "$stale_svc_code" != "404" ]; then
      echo "Failed to inspect OpenMetadata service '$service_name' (HTTP $stale_svc_code)" >&2
      exit 1
    fi
  }

  # Stage names are the closed set the profile schema allows, so iterating it
  # also finds the services of a stage that is no longer governed. Service
  # names follow the contract's canonical `dagster_<stage>` / `superset_<stage>`
  # (provider_contracts.py rejects any other).
  for stage in dev uat prod; do
    database="$(stage_field "$stage" catalog_database_name)"
    if [ -n "$database" ]; then
      ensure_stage_database "$database"
    fi

    pipeline_service="$(stage_field "$stage" pipeline_service_name)"
    if [ -n "$pipeline_service" ]; then
      register_service pipelineServices "$(jq -n \
        --arg name "$pipeline_service" \
        --arg display "Dagster Orchestrator ($stage)" \
        --arg host "$(stage_field "$stage" dagster_webserver_url)" \
        '{name: $name, displayName: $display, serviceType: "Dagster", connection: {config: {type: "Dagster", host: $host, timeout: 1000}}}')" \
        dagster-metadata-ingestion "Dagster Pipeline Metadata" PipelineMetadata pipelineService
    else
      remove_service pipelineServices "dagster_$stage" dagster-metadata-ingestion
    fi

    dashboard_service="$(stage_field "$stage" dashboard_service_name)"
    if [ -n "$dashboard_service" ]; then
      register_service dashboardServices "$(jq -n \
        --arg name "$dashboard_service" \
        --arg display "Superset Reporting ($stage)" \
        --arg host_port "$(stage_field "$stage" superset_url)" \
        --arg username "${superset_username}" \
        --arg password "${superset_password}" \
        --arg provider "${superset_auth_provider}" \
        --arg verify_ssl "${superset_verify_ssl}" \
        '{name: $name, displayName: $display, serviceType: "Superset", connection: {config: {type: "Superset", hostPort: $host_port, connection: {provider: $provider, username: $username, password: $password, verifySSL: $verify_ssl}}}}')" \
        superset-metadata-ingestion "Superset Dashboard Metadata" DashboardMetadata dashboardService
    else
      remove_service dashboardServices "superset_$stage" superset-metadata-ingestion
    fi
  done

  # The unqualified services every deployment registered before #131.
  remove_service pipelineServices dagster dagster-metadata-ingestion
  remove_service dashboardServices superset superset-metadata-ingestion

  # Create or reuse the Iceberg metadata ingestion pipeline.
  pipeline_fqn="$catalog_service.$catalog_service-metadata-ingestion"
  pipeline_code="$(curl -sS -o /tmp/om-pipeline-body -w '%%{http_code}' \
    "$om_url/api/v1/services/ingestionPipelines/name/$pipeline_fqn" \
    -H "Authorization: Bearer $ADMIN_JWT")"
  if [ "$pipeline_code" = "200" ]; then
    pipeline_resp="$(cat /tmp/om-pipeline-body)"
  elif [ "$pipeline_code" = "404" ]; then
    pipeline_code="$(curl -sS -o /tmp/om-pipeline-body -w '%%{http_code}' \
      -X POST "$om_url/api/v1/services/ingestionPipelines" \
      -H "Authorization: Bearer $ADMIN_JWT" \
      -H "Content-Type: application/json" \
      -d "{
        \"name\": \"$catalog_service-metadata-ingestion\",
        \"displayName\": \"$catalog_display Metadata Ingestion\",
        \"pipelineType\": \"metadata\",
        \"sourceConfig\": {
          \"config\": {
            \"type\": \"DatabaseMetadata\",
            \"includeViews\": false,
            \"includeTags\": false
          }
        },
         \"airflowConfig\": {
           \"startDate\": \"2025-01-01T00:00:00.000Z\",
           \"retries\": 1,
           \"pausePipeline\": true
         },
         \"service\": {
           \"id\": \"$svc_id\",
           \"type\": \"databaseService\"
         }
       }")"

    case " 200 201 " in
      *" $pipeline_code "*) pipeline_resp="$(cat /tmp/om-pipeline-body)" ;;
      *)
        echo "Failed to create ingestion pipeline (HTTP $pipeline_code)" >&2
        cat /tmp/om-pipeline-body >&2
        exit 1
        ;;
    esac
  else
    echo "Failed to inspect ingestion pipeline (HTTP $pipeline_code)" >&2
    cat /tmp/om-pipeline-body >&2
    exit 1
  fi

  pipeline_id="$(echo "$pipeline_resp" | jq -r '.id // empty')"

  if [ -z "$pipeline_id" ]; then
    echo "Failed to retrieve ingestion pipeline id" >&2
    exit 1
  fi

  # Deploy and trigger the first catalog crawl.
  deploy_code="$(curl -sS -o /tmp/om-deploy-body -w '%%{http_code}' \
    -X POST "$om_url/api/v1/services/ingestionPipelines/deploy/$pipeline_id" \
    -H "Authorization: Bearer $ADMIN_JWT")"
  case " 200 201 " in
    *" $deploy_code "*) ;;
    *)
      echo "Failed to deploy ingestion pipeline (HTTP $deploy_code)" >&2
      cat /tmp/om-deploy-body >&2
      exit 1
      ;;
  esac

  trigger_code="$(curl -sS -o /tmp/om-trigger-body -w '%%{http_code}' \
    -X POST "$om_url/api/v1/services/ingestionPipelines/trigger/$pipeline_id" \
    -H "Authorization: Bearer $ADMIN_JWT")"
  case " 200 201 202 " in
    *" $trigger_code "*) ;;
    *)
      echo "Failed to trigger ingestion pipeline (HTTP $trigger_code)" >&2
      cat /tmp/om-trigger-body >&2
      exit 1
      ;;
  esac

  echo "OpenMetadata bootstrap complete."
