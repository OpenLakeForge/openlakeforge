rand() { tr -dc 'A-Za-z0-9' </dev/urandom | head -c 32; }

# Returns 0 for a Secret that holds every key (kept as is), 1 for an absent
# one. A Secret missing a key is not ours to patch: fail instead.
exists() {
  name=$1; shift
  [ -n "$(kubectl get secret "$name" -n "$NAMESPACE" --ignore-not-found -o name)" ] || return 1
  for key in "$@"; do
    [ -n "$(kubectl get secret "$name" -n "$NAMESPACE" -o "jsonpath={.data['$key']}")" ] || {
      echo "Secret $name exists without key $key; refusing to modify it" >&2
      exit 1
    }
  done
  echo "Secret $name exists; keeping it"
}

# Keycloak ignores the Secret once its database holds the admin, so a new
# value after the Deployment has run would not match it.
if ! exists "${admin_secret_name}" username password; then
  if [ -n "$(kubectl get deployment "${release_name}" -n "$NAMESPACE" --ignore-not-found -o name)" ]; then
    echo "Secret ${admin_secret_name} is missing but Keycloak has run; recover the admin first (docs/architecture/identity-sessions-and-recovery.md)" >&2
    exit 1
  fi
  kubectl create secret generic "${admin_secret_name}" -n "$NAMESPACE" \
    --from-literal=username=admin --from-literal=password="$(rand)"
  echo "Created Secret ${admin_secret_name}"
fi

for client in ${clients}; do
  name="${release_name}-client-$client"
  if ! exists "$name" client-secret; then
    kubectl create secret generic "$name" -n "$NAMESPACE" --from-literal=client-secret="$(rand)"
    echo "Created Secret $name"
  fi
done
