rand() { tr -dc 'A-Za-z0-9' </dev/urandom | head -c 32; }

for client in ${clients}; do
  name="${release_name}-client-$client"
  if [ -n "$(kubectl get secret "$name" -n "$NAMESPACE" --ignore-not-found -o name)" ]; then
    # A Secret missing its key is not ours to patch: fail instead.
    [ -n "$(kubectl get secret "$name" -n "$NAMESPACE" -o 'jsonpath={.data.client-secret}')" ] || {
      echo "Secret $name exists without key client-secret; refusing to modify it" >&2
      exit 1
    }
    echo "Secret $name exists; keeping it"
  else
    kubectl create secret generic "$name" -n "$NAMESPACE" --from-literal=client-secret="$(rand)"
    echo "Created Secret $name"
  fi
done
