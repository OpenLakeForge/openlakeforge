rand() { tr -dc 'A-Za-z0-9' </dev/urandom | head -c 32; }

# Returns 0 for a Secret that holds every key (kept as is), 1 for an absent
# one. A Secret missing a key is not ours to patch: fail instead.
exists() {
  name=$1; shift
  [ -n "$(kubectl get secret "$name" -n "$NAMESPACE" --ignore-not-found -o name)" ] || return 1
  for key in "$@"; do
    [ -n "$(kubectl get secret "$name" -n "$NAMESPACE" -o "jsonpath={.data['$key']}")" ] || {
      echo "Secret $name exists without key $key; refusing to modify it" >&2
      exit 1
    }
  done
  echo "Secret $name exists; keeping it"
}

# Writes a derived Secret, replacing it in place so a reader never sees it
# missing. These Secrets are copies; the principal Secrets are the source.
put() {
  ns=$1; name=$2; shift 2
  if kubectl get secret "$name" -n "$ns" >/dev/null 2>&1; then
    kubectl create secret generic "$name" -n "$ns" "$@" --dry-run=client -o yaml | kubectl replace -f - >/dev/null
  else
    kubectl create secret generic "$name" -n "$ns" "$@" >/dev/null
  fi
  echo "Wrote Secret $name in $ns"
}

# An empty value would hash into a valid password, so it is an error.
field() {
  value=$(kubectl get secret "$1" -n "$NAMESPACE" -o "jsonpath={.data.$2}" | base64 -d)
  [ -n "$value" ] || { echo "Secret $1 has an empty $2" >&2; exit 1; }
  printf '%s' "$value"
}

for principal in ${principals}; do
  name="trino-credential-$principal"
  if ! exists "$name" username password; then
    kubectl create secret generic "$name" -n "$NAMESPACE" \
      --from-literal=username="$principal" --from-literal=password="$(rand)"
    echo "Created Secret $name"
  fi
done

if ! exists trino-internal-secret internal-communication.shared-secret; then
  kubectl create secret generic trino-internal-secret -n "$NAMESPACE" \
    --from-literal=internal-communication.shared-secret="$(rand)"
  echo "Created Secret trino-internal-secret"
fi

# Derived on every run, so a rotated or restored principal Secret reaches Trino
# without a restart.
lines=""
for principal in ${principals}; do
  password=$(field "trino-credential-$principal" password)
  lines="$lines$principal $password
"
done
printf '%s' "$lines" | python3 -c '${password_file_script}' >/tmp/password.db
put "$NAMESPACE" trino-password-file --from-file=password.db=/tmp/password.db
rm -f /tmp/password.db

# A Secret cannot be read across namespaces, and a stage namespace receives its
# own principal only (ADR 0016).
for pair in ${stage_namespaces}; do
  stage=$${pair%%=*}
  target=$${pair#*=}
  password=$(field "trino-credential-olf-$stage-runtime" password)
  put "$target" trino-credential --from-literal=username="olf-$stage-runtime" --from-literal=password="$password"
done
