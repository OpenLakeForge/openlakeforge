# The rewrite_tag emitter holds a Flush interval of records before the engine hands them to the S3 output, and a
# record it cannot take keeps its input tag, which no output matches: it is lost without an error. Flush 1 keeps that
# hold to a second of ingest, below the emitter's limit: 5000 lines/s of 1 KB lost 67% at Flush 5 and none at Flush 1
# with the limit set below.
[SERVICE]
    Flush                       1
    Grace                       30
    Log_Level                   info
    HTTP_Server                 On
    HTTP_Listen                 0.0.0.0
    HTTP_Port                   ${http_port}
    Health_Check                On
    storage.path                /var/fluent-bit/chunks/
    storage.sync                normal
    storage.metrics             On
    storage.max_chunks_up       ${max_chunks_up}
    storage.backlog.mem_limit   5M
%{ for stage, route in routes ~}

# ${stage}: one input per namespace, so the file name picks the route and no record field can.
[INPUT]
    Name                        tail
    Tag                         ${route.namespace}.*
    Path                        /var/log/containers/*_${route.namespace}_*.log
    Path_Key                    filepath
    Offset_Key                  offset
    multiline.parser            cri
    DB                          /var/fluent-bit/${stage}.db
    Read_from_Head              On
    Refresh_Interval            5
    Skip_Long_Lines             On
    Buffer_Max_Size             1M
    Mem_Buf_Limit               ${mem_buf_limit}
    storage.type                filesystem

[FILTER]
    Name                        record_modifier
    Match                       ${route.namespace}.var.*
    Record                      stage ${stage}

[FILTER]
    Name                        kubernetes
    Match                       ${route.namespace}.var.*
    Kube_Tag_Prefix             ${route.namespace}.var.log.containers.
    Merge_Log                   Off
    Annotations                 Off
    Labels                      On
    Use_Kubelet                 Off
    K8S-Logging.Parser          Off
    K8S-Logging.Exclude         Off

[FILTER]
    Name                        lua
    Match                       ${route.namespace}.var.*
    script                      /fluent-bit/etc/record.lua
    call                        build
    time_as_table               On
    type_array_key              missing

# The new tag is <namespace>.<UTC date>.<UTC hour> of the record: the S3 plugin keeps one buffer per tag, so an object
# holds one hour, and the key is built from the tag. The key takes no strftime time: the plugin uses the first record's
# for a fresh buffer but the restart time for a file left in the spool, so after an outage it would name the wrong hour.
[FILTER]
    Name                        rewrite_tag
    Match                       ${route.namespace}.var.*
    Rule                        $date ^(\d{4}-\d{2}-\d{2})$ ${route.namespace}.$date.$hour false
    Emitter_Name                retag_${stage}
    Emitter_Storage.type        filesystem
    # Above one Flush interval of the e2e's heaviest ingest (about 6 MB/s): at 10M that rate still lost 2% at Flush 1.
    Emitter_Mem_Buf_Limit       20M

[FILTER]
    Name                        record_modifier
    Match_Regex                 ^${route.namespace}\.\d{4}-\d{2}-\d{2}\.\d{2}$
    Remove_key                  date
    Remove_key                  hour

# Also the <namespace>.<date> tag of a collector before hour partitions, so its chunks still on disk at the upgrade are
# uploaded, not dropped by a Match that no longer names them. Such a tag has no third part, so the plugin fills
# hour=$TAG[2] with the whole tag (`hour=<namespace>.<date>[2]/`); the reader reads any sub-prefix that is not an hour
# whole, as it reads the objects of a day written before hours.
[OUTPUT]
    Name                        s3
    Match_Regex                 ^${route.namespace}\.\d{4}-\d{2}-\d{2}(\.\d{2})?$
    bucket                      ${bucket}
    region                      ${region}
    endpoint                    ${endpoint}
    use_put_object              On
    compression                 gzip
    total_file_size             8M
    upload_timeout              5m
    json_date_key               false
    s3_key_format               /${route.key_prefix}namespace=$TAG[0]/date=$TAG[1]/hour=$TAG[2]/${stage}-$UUID.ndjson.gz
    store_dir                   /var/fluent-bit/spool-${stage}
    store_dir_limit_size        ${spool_limit_size}
    # The default of 5 retries gave up after about a minute and moved the file out of the spool, where nothing resends
    # it and the spool signals cannot see it. Retrying until store_dir_limit_size makes that limit the loss point.
    retry_limit                 1000000
    retry_exhausted_action      quarantine
    # An unreachable store that drops packets (a NetworkPolicy, a blackholed route) holds the output's flush for two
    # connect timeouts per upload attempt. At the 10 s default the S3 output took in almost nothing while blocked, so
    # records overflowed the re-tag emitter and were lost before the spool: 5000 lines/s of 1 KB into a blackhole
    # spooled 20 MB at 10 s and 496 MB (the limit) at 2 s. A store in reach connects in milliseconds.
    net.connect_timeout         2
    quarantine_dir_limit_size   ${quarantine_limit_size}
    storage.total_limit_size    ${chunk_limit_size}
%{ endfor ~}
