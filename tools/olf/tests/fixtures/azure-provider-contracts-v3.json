{
  "schema_version": "3.0.0",
  "deployment": {"profile_name": "acme-data", "provider": "azure", "region": "westeurope"},
  "shared": {
    "foundation": {"ref": "shared/foundation", "implementation": "foundation.aks"},
    "kubernetes_platform": {"ref": "shared/kubernetes_platform", "implementation": "platform.kubernetes.aks"},
    "metadata_database": {"ref": "shared/metadata_database", "implementation": "metadata_database.postgresql.in_cluster_on_aks"},
    "query": {"ref": "shared/query", "implementation": "query.trino"},
    "catalog_service": {"ref": "shared/catalog_service", "implementation": "catalog.iceberg_rest.polaris_on_aks"},
    "artifact_registry": {"ref": "shared/artifact_registry", "implementation": "artifacts.azure_acr"},
    "ops_storage": {"ref": "shared/ops_storage", "implementation": "artifacts.azure_acr_and_s3_compatible_bucket", "bucket_name": "acme-ops", "artifact_base_uri": "s3://acme-ops"},
    "secrets": {"ref": "shared/secrets", "implementation": "secrets.kubernetes_secret_on_aks"},
    "identity": {"ref": "shared/identity", "implementation": "identity.azure_workload_identity_ready", "roles": {"precedence": ["platform-admin", "data-engineer", "analyst", "viewer"], "grants": {"orchestration": {"platform-admin": "full", "data-engineer": "full"}, "reporting": {"platform-admin": "Admin", "data-engineer": "Alpha", "analyst": "Gamma", "viewer": "read-only"}, "governance_service": {"platform-admin": "Admin", "data-engineer": "write", "analyst": "read", "viewer": "read"}, "query": {"platform-admin": "yes", "data-engineer": "yes"}}}},
    "access": {"ref": "shared/access", "implementation": "access.kubectl_port_forward"},
    "observability": {"ref": "shared/observability", "implementation": "observability.object_log_archive_on_aks"}
  },
  "stages": {
    "dev": {"namespace": "olf-dev", "storage": {"provider": "azure", "implementation": "storage.s3_compatible.seaweedfs_on_aks", "protocol": "s3", "region": "westeurope", "identity_ref": "stage/dev/runtime_identity", "bronze": {"physical_id": "acme-dev-bronze", "bucket_name": "acme-dev-bronze", "uri": "s3://acme-dev-bronze"}, "silver": {"physical_id": "acme-dev-silver", "bucket_name": "acme-dev-silver", "uri": "s3://acme-dev-silver"}, "gold": {"physical_id": "acme-dev-gold", "bucket_name": "acme-dev-gold", "uri": "s3://acme-dev-gold"}}, "catalog": {"logical_name": "iceberg_catalog", "implementation": "catalog.iceberg_rest.polaris_on_aks", "catalog_type": "rest", "catalog_provider": "polaris", "catalog_name": "lakehouse_dev", "runtime_profile": "polaris-rest", "physical_id": "lakehouse_dev", "service_ref": "shared/catalog_service"}, "query": {"service_ref": "shared/query", "catalog_ref": "stage/dev/catalog", "catalog_name": "lakehouse_dev", "endpoint": "http://trino:8080", "runtime_identity_ref": "stage/dev/runtime_identity"}, "orchestration": {"service_ref": "stage/dev/orchestration", "endpoint_ref": "stage/dev/endpoints/orchestration", "code_locations": [{"name": "openlakeforge-dagster", "definitions_module": "lakehouse_code.definitions"}]}, "activation": {"ops_storage_ref": "shared/ops_storage", "prefix": "activations/dev"}, "endpoints": {"catalog": "shared/catalog_service", "query": "shared/query", "orchestration": "stage/dev/endpoints/orchestration"}, "runtime_identity": {"ref": "stage/dev/runtime_identity", "principal": "olf-dev-runtime"}},
    "prod": {"namespace": "olf-prod", "storage": {"provider": "azure", "implementation": "storage.s3_compatible.seaweedfs_on_aks", "protocol": "s3", "region": "westeurope", "identity_ref": "stage/prod/runtime_identity", "bronze": {"physical_id": "acme-prod-bronze", "bucket_name": "acme-prod-bronze", "uri": "s3://acme-prod-bronze"}, "silver": {"physical_id": "acme-prod-silver", "bucket_name": "acme-prod-silver", "uri": "s3://acme-prod-silver"}, "gold": {"physical_id": "acme-prod-gold", "bucket_name": "acme-prod-gold", "uri": "s3://acme-prod-gold"}}, "catalog": {"logical_name": "iceberg_catalog", "implementation": "catalog.iceberg_rest.polaris_on_aks", "catalog_type": "rest", "catalog_provider": "polaris", "catalog_name": "lakehouse_prod", "runtime_profile": "polaris-rest", "physical_id": "lakehouse_prod", "service_ref": "shared/catalog_service"}, "query": {"service_ref": "shared/query", "catalog_ref": "stage/prod/catalog", "catalog_name": "lakehouse_prod", "endpoint": "http://trino:8080", "runtime_identity_ref": "stage/prod/runtime_identity"}, "orchestration": {"service_ref": "stage/prod/orchestration", "endpoint_ref": "stage/prod/endpoints/orchestration", "code_locations": [{"name": "openlakeforge-dagster", "definitions_module": "lakehouse_code.definitions"}]}, "activation": {"ops_storage_ref": "shared/ops_storage", "prefix": "activations/prod"}, "endpoints": {"catalog": "shared/catalog_service", "query": "shared/query", "orchestration": "stage/prod/endpoints/orchestration"}, "runtime_identity": {"ref": "stage/prod/runtime_identity", "principal": "olf-prod-runtime"}}
  }
}
