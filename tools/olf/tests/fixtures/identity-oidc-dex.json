{
  "implementation": "identity.oidc",
  "issuer_url": "https://auth.olf.localhost",
  "internal_url": "http://dex.olf-system.svc.cluster.local:5556",
  "role_claim": "groups",
  "role_mapping": {
    "platform-admin": ["OpenLakeForge:olf-platform-admins"],
    "data-engineer": ["OpenLakeForge:olf-data-engineers"],
    "analyst": ["OpenLakeForge:olf-analysts"],
    "viewer": ["OpenLakeForge:olf-viewers"]
  },
  "clients": {
    "perimeter": {"client_id": "perimeter", "secret_ref": {"name": "dex-client-perimeter", "key": "client-secret"}},
    "superset": {"client_id": "superset", "secret_ref": {"name": "dex-client-superset", "key": "client-secret"}},
    "openmetadata": {
      "client_id": "openmetadata",
      "secret_ref": {"name": "dex-client-openmetadata", "key": "client-secret"}
    },
    "olf-cli": {"client_id": "olf-cli"}
  },
  "adapter": "dex",
  "capabilities": {"email_delivery": false, "groups_in_token": true, "logout_endpoint": false}
}
