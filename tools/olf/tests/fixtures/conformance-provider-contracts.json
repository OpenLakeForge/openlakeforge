{
  "deployment": {
    "profile_name": "olf-conformance",
    "provider": "local",
    "region": null
  },
  "schema_version": "3.0.0",
  "shared": {
    "access": {
      "base_domain": "olf.localhost",
      "implementation": "access.ingress",
      "issuer": "local-ca",
      "perimeter": {
        "callback_url": "https://oauth2.olf.localhost/oauth2/callback",
        "enabled": true,
        "implementation": "perimeter.oauth2_proxy",
        "protected_routes": [
          "shared/governance_service",
          "shared/portal",
          "shared/query",
          "stage/dev/orchestration",
          "stage/dev/reporting",
          "stage/prod/orchestration",
          "stage/prod/reporting"
        ]
      },
      "ref": "shared/access",
      "routes": {
        "shared/governance_service": {
          "enabled": true,
          "exposure": "user-facing",
          "url": "https://openmetadata.olf.localhost"
        },
        "shared/identity": {
          "enabled": true,
          "exposure": "user-facing",
          "url": "https://auth.olf.localhost"
        },
        "shared/portal": {
          "enabled": true,
          "exposure": "user-facing",
          "url": "https://olf.localhost"
        },
        "shared/query": {
          "enabled": true,
          "exposure": "user-facing",
          "url": "https://trino.olf.localhost"
        },
        "stage/dev/orchestration": {
          "enabled": true,
          "exposure": "user-facing",
          "url": "https://dagster-dev.olf.localhost"
        },
        "stage/dev/reporting": {
          "enabled": true,
          "exposure": "user-facing",
          "url": "https://superset-dev.olf.localhost"
        },
        "stage/prod/orchestration": {
          "enabled": true,
          "exposure": "user-facing",
          "url": "https://dagster-prod.olf.localhost"
        },
        "stage/prod/reporting": {
          "enabled": true,
          "exposure": "user-facing",
          "url": "https://superset-prod.olf.localhost"
        }
      },
      "tls_mode": "ingress-terminated"
    },
    "artifact_registry": {
      "implementation": "artifacts.local_kind_image_load",
      "ref": "shared/artifact_registry"
    },
    "catalog_service": {
      "endpoint": "http://polaris.olf-system:8181/api/catalog",
      "implementation": "catalog.iceberg_rest.polaris",
      "ref": "shared/catalog_service"
    },
    "foundation": {
      "implementation": "foundation.kind",
      "ref": "shared/foundation"
    },
    "governance_service": {
      "endpoint": "http://openmetadata.olf-system:8585",
      "implementation": "governance.openmetadata",
      "ref": "shared/governance_service"
    },
    "identity": {
      "adapter": "dex",
      "capabilities": {
        "email_delivery": false,
        "groups_in_token": true,
        "logout_endpoint": false
      },
      "clients": {
        "openmetadata": {
          "client_id": "openmetadata",
          "secret_ref": {
            "key": "client-secret",
            "name": "dex-client-openmetadata"
          }
        },
        "olf-cli": {
          "client_id": "olf-cli"
        },
        "perimeter": {
          "client_id": "perimeter",
          "secret_ref": {
            "key": "client-secret",
            "name": "dex-client-perimeter"
          }
        },
        "superset": {
          "client_id": "superset",
          "secret_ref": {
            "key": "client-secret",
            "name": "dex-client-superset"
          }
        },
        "trino": {
          "client_id": "trino",
          "secret_ref": {
            "key": "client-secret",
            "name": "dex-client-trino"
          }
        }
      },
      "implementation": "identity.oidc",
      "issuer_url": "https://auth.olf.localhost",
      "ref": "shared/identity",
      "role_claim": "groups",
      "role_mapping": {
        "analyst": [
          "OpenLakeForge:olf-analysts"
        ],
        "data-engineer": [
          "OpenLakeForge:olf-data-engineers"
        ],
        "platform-admin": [
          "OpenLakeForge:olf-platform-admins"
        ],
        "viewer": [
          "OpenLakeForge:olf-viewers"
        ]
      },
      "roles": {
        "data_access": {
          "analyst": {
            "dev": {
              "gold": "read"
            },
            "prod": {
              "gold": "read"
            },
            "uat": {
              "gold": "read"
            }
          },
          "data-engineer": {
            "dev": {
              "bronze": "write",
              "gold": "write",
              "silver": "write"
            },
            "prod": {
              "bronze": "read",
              "gold": "read",
              "silver": "read"
            },
            "uat": {
              "bronze": "read",
              "gold": "read",
              "silver": "read"
            }
          },
          "platform-admin": {
            "dev": {
              "bronze": "write",
              "gold": "write",
              "silver": "write"
            },
            "prod": {
              "bronze": "write",
              "gold": "write",
              "silver": "write"
            },
            "uat": {
              "bronze": "write",
              "gold": "write",
              "silver": "write"
            }
          },
          "viewer": {
            "prod": {
              "gold": "read"
            },
            "uat": {
              "gold": "read"
            }
          }
        },
        "grants": {
          "governance_service": {
            "analyst": "read",
            "data-engineer": "write",
            "platform-admin": "Admin",
            "viewer": "read"
          },
          "orchestration": {
            "data-engineer": "full",
            "platform-admin": "full"
          },
          "query": {
            "data-engineer": "yes",
            "platform-admin": "yes"
          },
          "reporting": {
            "analyst": "Gamma",
            "data-engineer": "Alpha",
            "platform-admin": "Admin",
            "viewer": "read-only"
          }
        },
        "precedence": [
          "platform-admin",
          "data-engineer",
          "analyst",
          "viewer"
        ]
      }
    },
    "kubernetes_platform": {
      "implementation": "kubernetes.kind",
      "ref": "shared/kubernetes_platform"
    },
    "metadata_database": {
      "implementation": "metadata_database.postgresql.in_cluster",
      "ref": "shared/metadata_database"
    },
    "observability": {
      "implementation": "observability.object_log_archive",
      "ref": "shared/observability"
    },
    "ops_storage": {
      "access_key_id_key": "AWS_ACCESS_KEY_ID",
      "access_mode": "remote",
      "artifact_base_uri": "s3://openlakeforge-ops",
      "bucket_name": "openlakeforge-ops",
      "credentials_secret_name": "seaweedfs-s3-creds",
      "implementation": "artifacts.s3_compatible_bucket",
      "local_upload_access_mode": "kubectl-port-forward",
      "ref": "shared/ops_storage",
      "secret_access_key_key": "AWS_SECRET_ACCESS_KEY"
    },
    "portal": {
      "implementation": "portal.static_page",
      "ref": "shared/portal"
    },
    "query": {
      "endpoint": "http://trino.olf-system:8080",
      "implementation": "query.trino",
      "ref": "shared/query"
    },
    "secrets": {
      "implementation": "secrets.kubernetes_secret",
      "ref": "shared/secrets"
    }
  },
  "stages": {
    "dev": {
      "activation": {
        "ops_storage_ref": "shared/ops_storage",
        "prefix": "activations/dev"
      },
      "catalog": {
        "catalog_name": "lakehouse_dev",
        "catalog_namespace_model": "medallion-owner",
        "catalog_provider": "polaris",
        "catalog_type": "rest",
        "deployer_client_id_key": "POLARIS_DEPLOYER_CLIENT_ID",
        "deployer_client_secret_key": "POLARIS_DEPLOYER_CLIENT_SECRET",
        "deployer_credentials_secret_name": "polaris-dev-deployer-creds",
        "floe_client_id_key": "POLARIS_FLOE_CLIENT_ID",
        "floe_client_secret_key": "POLARIS_FLOE_CLIENT_SECRET",
        "floe_credentials_secret_name": "polaris-dev-floe-creds",
        "implementation": "catalog.iceberg_rest.polaris",
        "logical_name": "iceberg_catalog",
        "oauth_scope": "PRINCIPAL_ROLE:ALL",
        "physical_id": "lakehouse_dev",
        "rest_uri": "http://polaris.olf-system:8181/api/catalog",
        "runtime_profile": "polaris-rest",
        "service_ref": "shared/catalog_service",
        "token_uri": "http://polaris.olf-system:8181/api/catalog/v1/oauth/tokens",
        "warehouse": "lakehouse_dev"
      },
      "endpoints": {
        "catalog": "shared/catalog_service",
        "governance": "stage/dev/endpoints/governance",
        "orchestration": "stage/dev/endpoints/orchestration",
        "query": "shared/query",
        "reporting": "stage/dev/endpoints/reporting"
      },
      "governance": {
        "endpoint_ref": "stage/dev/endpoints/governance",
        "service_ref": "shared/governance_service"
      },
      "namespace": "olf-dev",
      "orchestration": {
        "code_locations": [
          {
            "definitions_module": "lakehouse_code.definitions",
            "name": "openlakeforge-dagster"
          }
        ],
        "endpoint_ref": "stage/dev/endpoints/orchestration",
        "pipeline_service_name": "dagster_dev",
        "service_ref": "stage/dev/orchestration"
      },
      "query": {
        "ca_configmap_name": "olf-local-ca",
        "catalog_name": "lakehouse_dev",
        "catalog_ref": "stage/dev/catalog",
        "credential_secret_name": "trino-credential",
        "endpoint": "http://trino.olf-system:8080",
        "runtime_identity_ref": "stage/dev/runtime_identity",
        "service_ref": "shared/query",
        "tls_port": "8443"
      },
      "reporting": {
        "dashboard_service_name": "superset_dev",
        "endpoint_ref": "stage/dev/endpoints/reporting",
        "service_ref": "stage/dev/reporting"
      },
      "runtime_identity": {
        "principal": "olf-dev-runtime",
        "ref": "stage/dev/runtime_identity"
      },
      "storage": {
        "access_key_id_key": "AWS_ACCESS_KEY_ID",
        "bronze": {
          "bucket_name": "lakehouse-dev-bronze",
          "physical_id": "lakehouse-dev-bronze",
          "uri": "s3://lakehouse-dev-bronze"
        },
        "credentials_secret_name": "seaweedfs-dev-s3-creds",
        "endpoint": "http://seaweedfs-s3.olf-system:8333",
        "gold": {
          "bucket_name": "lakehouse-dev-gold",
          "physical_id": "lakehouse-dev-gold",
          "uri": "s3://lakehouse-dev-gold"
        },
        "identity_ref": "stage/dev/runtime_identity",
        "implementation": "storage.s3_compatible.seaweedfs",
        "path_style_access": true,
        "protocol": "s3",
        "provider": "local",
        "region": "us-east-1",
        "s3_service_name": "seaweedfs-s3",
        "s3_service_port": 8333,
        "secret_access_key_key": "AWS_SECRET_ACCESS_KEY",
        "silver": {
          "bucket_name": "lakehouse-dev-silver",
          "physical_id": "lakehouse-dev-silver",
          "uri": "s3://lakehouse-dev-silver"
        },
        "ssl_mode": "disabled",
        "virtual_host_endpoint": "http://olf-system.svc.cluster.local:8333"
      }
    },
    "prod": {
      "activation": {
        "ops_storage_ref": "shared/ops_storage",
        "prefix": "activations/prod"
      },
      "catalog": {
        "catalog_name": "lakehouse_prod",
        "catalog_namespace_model": "medallion-owner",
        "catalog_provider": "polaris",
        "catalog_type": "rest",
        "deployer_client_id_key": "POLARIS_DEPLOYER_CLIENT_ID",
        "deployer_client_secret_key": "POLARIS_DEPLOYER_CLIENT_SECRET",
        "deployer_credentials_secret_name": "polaris-prod-deployer-creds",
        "floe_client_id_key": "POLARIS_FLOE_CLIENT_ID",
        "floe_client_secret_key": "POLARIS_FLOE_CLIENT_SECRET",
        "floe_credentials_secret_name": "polaris-prod-floe-creds",
        "implementation": "catalog.iceberg_rest.polaris",
        "logical_name": "iceberg_catalog",
        "oauth_scope": "PRINCIPAL_ROLE:ALL",
        "physical_id": "lakehouse_prod",
        "rest_uri": "http://polaris.olf-system:8181/api/catalog",
        "runtime_profile": "polaris-rest",
        "service_ref": "shared/catalog_service",
        "token_uri": "http://polaris.olf-system:8181/api/catalog/v1/oauth/tokens",
        "warehouse": "lakehouse_prod"
      },
      "endpoints": {
        "catalog": "shared/catalog_service",
        "governance": "stage/prod/endpoints/governance",
        "orchestration": "stage/prod/endpoints/orchestration",
        "query": "shared/query",
        "reporting": "stage/prod/endpoints/reporting"
      },
      "governance": {
        "endpoint_ref": "stage/prod/endpoints/governance",
        "service_ref": "shared/governance_service"
      },
      "namespace": "olf-prod",
      "orchestration": {
        "code_locations": [
          {
            "definitions_module": "lakehouse_code.definitions",
            "name": "openlakeforge-dagster"
          }
        ],
        "endpoint_ref": "stage/prod/endpoints/orchestration",
        "pipeline_service_name": "dagster_prod",
        "service_ref": "stage/prod/orchestration"
      },
      "query": {
        "ca_configmap_name": "olf-local-ca",
        "catalog_name": "lakehouse_prod",
        "catalog_ref": "stage/prod/catalog",
        "credential_secret_name": "trino-credential",
        "endpoint": "http://trino.olf-system:8080",
        "runtime_identity_ref": "stage/prod/runtime_identity",
        "service_ref": "shared/query",
        "tls_port": "8443"
      },
      "reporting": {
        "dashboard_service_name": "superset_prod",
        "endpoint_ref": "stage/prod/endpoints/reporting",
        "service_ref": "stage/prod/reporting"
      },
      "runtime_identity": {
        "principal": "olf-prod-runtime",
        "ref": "stage/prod/runtime_identity"
      },
      "storage": {
        "access_key_id_key": "AWS_ACCESS_KEY_ID",
        "bronze": {
          "bucket_name": "lakehouse-prod-bronze",
          "physical_id": "lakehouse-prod-bronze",
          "uri": "s3://lakehouse-prod-bronze"
        },
        "credentials_secret_name": "seaweedfs-prod-s3-creds",
        "endpoint": "http://seaweedfs-s3.olf-system:8333",
        "gold": {
          "bucket_name": "lakehouse-prod-gold",
          "physical_id": "lakehouse-prod-gold",
          "uri": "s3://lakehouse-prod-gold"
        },
        "identity_ref": "stage/prod/runtime_identity",
        "implementation": "storage.s3_compatible.seaweedfs",
        "path_style_access": true,
        "protocol": "s3",
        "provider": "local",
        "region": "us-east-1",
        "s3_service_name": "seaweedfs-s3",
        "s3_service_port": 8333,
        "secret_access_key_key": "AWS_SECRET_ACCESS_KEY",
        "silver": {
          "bucket_name": "lakehouse-prod-silver",
          "physical_id": "lakehouse-prod-silver",
          "uri": "s3://lakehouse-prod-silver"
        },
        "ssl_mode": "disabled",
        "virtual_host_endpoint": "http://olf-system.svc.cluster.local:8333"
      }
    }
  }
}
