{
  "schema_version": "3.0.0",
  "deployment": {"profile_name": "acme-data", "provider": "local", "region": null},
  "shared": {
    "foundation": {"ref": "shared/foundation", "implementation": "foundation.kind"},
    "kubernetes_platform": {"ref": "shared/kubernetes_platform", "implementation": "platform.kubernetes.kind"},
    "metadata_database": {"ref": "shared/metadata_database", "implementation": "metadata_database.postgresql.in_cluster"},
    "query": {"ref": "shared/query", "implementation": "query.trino", "endpoint": "http://trino:8080"},
    "catalog_service": {"ref": "shared/catalog_service", "implementation": "catalog.iceberg_rest.polaris", "endpoint": "http://polaris:8181/api/catalog"},
    "artifact_registry": {"ref": "shared/artifact_registry", "implementation": "artifacts.local_kind_image_load"},
    "ops_storage": {"ref": "shared/ops_storage", "implementation": "artifacts.local_kind_and_s3", "bucket_name": "openlakeforge-ops", "artifact_base_uri": "s3://openlakeforge-ops", "access_mode": "remote", "local_upload_access_mode": "kubectl-port-forward"},
    "secrets": {"ref": "shared/secrets", "implementation": "secrets.kubernetes_secret"},
    "identity": {"ref": "shared/identity", "implementation": "identity.local_development_credentials", "roles": {"precedence": ["platform-admin", "data-engineer", "analyst", "viewer"], "grants": {"orchestration": {"platform-admin": "full", "data-engineer": "full"}, "reporting": {"platform-admin": "Admin", "data-engineer": "Alpha", "analyst": "Gamma", "viewer": "read-only"}, "governance_service": {"platform-admin": "Admin", "data-engineer": "write", "analyst": "read", "viewer": "read"}, "query": {"platform-admin": "yes", "data-engineer": "yes"}}}},
    "portal": {"ref": "shared/portal", "implementation": "portal.static_page"},
    "access": {"ref": "shared/access", "implementation": "access.ingress", "base_domain": "olf.localhost", "issuer": "local-ca", "tls_mode": "ingress-terminated", "routes": {
      "shared/portal": {"url": "https://olf.localhost", "enabled": true, "exposure": "user-facing"},
      "shared/query": {"url": "https://trino.olf.localhost", "enabled": true, "exposure": "user-facing"},
      "stage/dev/orchestration": {"url": "https://dagster.dev.olf.localhost", "enabled": true, "exposure": "user-facing"},
      "stage/prod/orchestration": {"url": "https://dagster.prod.olf.localhost", "enabled": true, "exposure": "user-facing"}
    }},
    "observability": {"ref": "shared/observability", "implementation": "observability.object_log_archive"}
  },
  "stages": {
    "dev": {
      "namespace": "olf-dev",
      "storage": {"provider": "local", "implementation": "storage.s3_compatible.seaweedfs", "protocol": "s3", "region": "us-east-1", "endpoint": "http://seaweedfs-s3:8333", "virtual_host_endpoint": "http://lakehouse.svc.cluster.local:8333", "path_style_access": true, "ssl_mode": "disabled", "credentials_secret_name": "seaweedfs-s3-creds", "access_key_id_key": "AWS_ACCESS_KEY_ID", "secret_access_key_key": "AWS_SECRET_ACCESS_KEY", "s3_service_name": "seaweedfs-s3", "s3_service_port": 8333, "identity_ref": "stage/dev/runtime_identity", "bronze": {"physical_id": "acme-dev-bronze", "bucket_name": "acme-dev-bronze", "uri": "s3://acme-dev-bronze"}, "silver": {"physical_id": "acme-dev-silver", "bucket_name": "acme-dev-silver", "uri": "s3://acme-dev-silver"}, "gold": {"physical_id": "acme-dev-gold", "bucket_name": "acme-dev-gold", "uri": "s3://acme-dev-gold"}},
      "catalog": {"logical_name": "iceberg_catalog", "implementation": "catalog.iceberg_rest.polaris", "catalog_type": "rest", "catalog_provider": "polaris", "catalog_name": "lakehouse_dev", "runtime_profile": "polaris-rest", "physical_id": "lakehouse_dev", "service_ref": "shared/catalog_service", "warehouse": "lakehouse_dev", "rest_uri": "http://polaris:8181/api/catalog", "token_uri": "http://polaris:8181/api/catalog/v1/oauth/tokens", "oauth_scope": "PRINCIPAL_ROLE:ALL", "catalog_namespace_model": "medallion-owner", "floe_credentials_secret_name": "polaris-floe-creds", "floe_client_id_key": "POLARIS_FLOE_CLIENT_ID", "floe_client_secret_key": "POLARIS_FLOE_CLIENT_SECRET", "deployer_credentials_secret_name": "polaris-deployer-creds", "deployer_client_id_key": "POLARIS_DEPLOYER_CLIENT_ID", "deployer_client_secret_key": "POLARIS_DEPLOYER_CLIENT_SECRET"},
      "query": {"service_ref": "shared/query", "catalog_ref": "stage/dev/catalog", "catalog_name": "lakehouse_dev", "endpoint": "http://trino:8080", "runtime_identity_ref": "stage/dev/runtime_identity"},
      "orchestration": {"service_ref": "stage/dev/orchestration", "endpoint_ref": "stage/dev/endpoints/orchestration", "pipeline_service_name": "dagster_dev", "code_locations": [{"name": "openlakeforge-dagster", "definitions_module": "lakehouse_code.definitions"}]},
      "activation": {"ops_storage_ref": "shared/ops_storage", "prefix": "activations/dev"},
      "endpoints": {"catalog": "shared/catalog_service", "query": "shared/query", "orchestration": "stage/dev/endpoints/orchestration"},
      "runtime_identity": {"ref": "stage/dev/runtime_identity", "principal": "olf-dev-runtime"}
    },
    "prod": {
      "namespace": "olf-prod",
      "storage": {"provider": "local", "implementation": "storage.s3_compatible.seaweedfs", "protocol": "s3", "region": "us-east-1", "endpoint": "http://seaweedfs-s3:8333", "virtual_host_endpoint": "http://lakehouse.svc.cluster.local:8333", "path_style_access": true, "ssl_mode": "disabled", "credentials_secret_name": "seaweedfs-s3-creds", "access_key_id_key": "AWS_ACCESS_KEY_ID", "secret_access_key_key": "AWS_SECRET_ACCESS_KEY", "s3_service_name": "seaweedfs-s3", "s3_service_port": 8333, "identity_ref": "stage/prod/runtime_identity", "bronze": {"physical_id": "acme-prod-bronze", "bucket_name": "acme-prod-bronze", "uri": "s3://acme-prod-bronze"}, "silver": {"physical_id": "acme-prod-silver", "bucket_name": "acme-prod-silver", "uri": "s3://acme-prod-silver"}, "gold": {"physical_id": "acme-prod-gold", "bucket_name": "acme-prod-gold", "uri": "s3://acme-prod-gold"}},
      "catalog": {"logical_name": "iceberg_catalog", "implementation": "catalog.iceberg_rest.polaris", "catalog_type": "rest", "catalog_provider": "polaris", "catalog_name": "lakehouse_prod", "runtime_profile": "polaris-rest", "physical_id": "lakehouse_prod", "service_ref": "shared/catalog_service", "warehouse": "lakehouse_prod", "rest_uri": "http://polaris:8181/api/catalog", "token_uri": "http://polaris:8181/api/catalog/v1/oauth/tokens", "oauth_scope": "PRINCIPAL_ROLE:ALL", "catalog_namespace_model": "medallion-owner", "floe_credentials_secret_name": "polaris-floe-creds", "floe_client_id_key": "POLARIS_FLOE_CLIENT_ID", "floe_client_secret_key": "POLARIS_FLOE_CLIENT_SECRET", "deployer_credentials_secret_name": "polaris-deployer-creds", "deployer_client_id_key": "POLARIS_DEPLOYER_CLIENT_ID", "deployer_client_secret_key": "POLARIS_DEPLOYER_CLIENT_SECRET"},
      "query": {"service_ref": "shared/query", "catalog_ref": "stage/prod/catalog", "catalog_name": "lakehouse_prod", "endpoint": "http://trino:8080", "runtime_identity_ref": "stage/prod/runtime_identity"},
      "orchestration": {"service_ref": "stage/prod/orchestration", "endpoint_ref": "stage/prod/endpoints/orchestration", "pipeline_service_name": "dagster_prod", "code_locations": [{"name": "openlakeforge-dagster", "definitions_module": "lakehouse_code.definitions"}]},
      "activation": {"ops_storage_ref": "shared/ops_storage", "prefix": "activations/prod"},
      "endpoints": {"catalog": "shared/catalog_service", "query": "shared/query", "orchestration": "stage/prod/endpoints/orchestration"},
      "runtime_identity": {"ref": "stage/prod/runtime_identity", "principal": "olf-prod-runtime"}
    }
  }
}
