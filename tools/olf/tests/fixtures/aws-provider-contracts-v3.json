{
  "schema_version": "3.0.0",
  "deployment": {
    "profile_name": "acme-data",
    "provider": "aws",
    "region": "eu-west-3"
  },
  "shared": {
    "foundation": {
      "ref": "shared/foundation",
      "implementation": "foundation.eks"
    },
    "kubernetes_platform": {
      "ref": "shared/kubernetes_platform",
      "implementation": "platform.kubernetes.eks"
    },
    "metadata_database": {
      "ref": "shared/metadata_database",
      "implementation": "metadata_database.aws_rds_postgresql"
    },
    "query": {
      "ref": "shared/query",
      "implementation": "query.trino"
    },
    "governance_service": {
      "ref": "shared/governance_service",
      "implementation": "governance.openmetadata"
    },
    "artifact_registry": {
      "ref": "shared/artifact_registry",
      "implementation": "artifacts.aws_ecr"
    },
    "ops_storage": {
      "ref": "shared/ops_storage",
      "implementation": "artifacts.aws_ecr_and_s3",
      "bucket_name": "acme-ops",
      "artifact_base_uri": "s3://acme-ops"
    },
    "secrets": {
      "ref": "shared/secrets",
      "implementation": "secrets.kubernetes_secret_on_eks"
    },
    "identity": {
      "ref": "shared/identity",
      "implementation": "identity.aws_pod_identity",
      "roles": {"precedence": ["platform-admin", "data-engineer", "analyst", "viewer"], "grants": {"orchestration": {"platform-admin": "full", "data-engineer": "full"}, "reporting": {"platform-admin": "Admin", "data-engineer": "Alpha", "analyst": "Gamma", "viewer": "read-only"}, "governance_service": {"platform-admin": "Admin", "data-engineer": "write", "analyst": "read", "viewer": "read"}, "query": {"platform-admin": "yes", "data-engineer": "yes"}}}
    },
    "access": {
      "ref": "shared/access",
      "implementation": "access.kubectl_port_forward"
    },
    "observability": {
      "ref": "shared/observability",
      "implementation": "observability.object_log_archive_on_eks"
    }
  },
  "stages": {
    "dev": {
      "namespace": "olf-dev",
      "storage": {
        "provider": "aws",
        "implementation": "storage.aws_s3",
        "protocol": "s3",
        "region": "eu-west-3",
        "identity_ref": "stage/dev/runtime_identity",
        "bronze": {
          "physical_id": "acme-dev-bronze",
          "bucket_name": "acme-dev-bronze",
          "uri": "s3://acme-dev-bronze"
        },
        "silver": {
          "physical_id": "acme-dev-silver",
          "bucket_name": "acme-dev-silver",
          "uri": "s3://acme-dev-silver"
        },
        "gold": {
          "physical_id": "acme-dev-gold",
          "bucket_name": "acme-dev-gold",
          "uri": "s3://acme-dev-gold"
        }
      },
      "catalog": {
        "logical_name": "iceberg_catalog",
        "implementation": "catalog.aws_glue",
        "catalog_type": "glue",
        "catalog_provider": "aws-glue",
        "catalog_name": "lakehouse_dev",
        "runtime_profile": "aws-glue",
        "physical_id": "123456789012",
        "glue_region": "eu-west-3",
        "glue_catalog_id": "123456789012",
        "glue_rest_uri": "https://glue.eu-west-3.amazonaws.com/iceberg",
        "glue_rest_warehouse": "123456789012",
        "glue_warehouse_prefix": "warehouse/iceberg",
        "catalog_namespace_model": "medallion-owner"
      },
      "query": {
        "service_ref": "shared/query",
        "catalog_ref": "stage/dev/catalog",
        "catalog_name": "lakehouse_dev",
        "endpoint": "http://trino:8080",
        "runtime_identity_ref": "stage/dev/runtime_identity"
      },
      "orchestration": {
        "service_ref": "stage/dev/orchestration",
        "endpoint_ref": "stage/dev/endpoints/orchestration",
        "code_locations": [
          {"name": "openlakeforge-dagster", "definitions_module": "lakehouse_code.definitions"}
        ]
      },
      "reporting": {
        "service_ref": "stage/dev/reporting",
        "endpoint_ref": "stage/dev/endpoints/reporting"
      },
      "governance": {
        "service_ref": "shared/governance_service",
        "endpoint_ref": "stage/dev/endpoints/governance"
      },
      "activation": {
        "ops_storage_ref": "shared/ops_storage",
        "prefix": "activations/dev"
      },
      "endpoints": {
        "catalog": "stage/dev/catalog",
        "query": "shared/query",
        "orchestration": "stage/dev/endpoints/orchestration",
        "reporting": "stage/dev/endpoints/reporting",
        "governance": "stage/dev/endpoints/governance"
      },
      "runtime_identity": {
        "ref": "stage/dev/runtime_identity",
        "principal": "olf-dev-runtime"
      }
    },
    "uat": {
      "namespace": "olf-uat",
      "storage": {
        "provider": "aws",
        "implementation": "storage.aws_s3",
        "protocol": "s3",
        "region": "eu-west-3",
        "identity_ref": "stage/uat/runtime_identity",
        "bronze": {
          "physical_id": "acme-uat-bronze",
          "bucket_name": "acme-uat-bronze",
          "uri": "s3://acme-uat-bronze"
        },
        "silver": {
          "physical_id": "acme-uat-silver",
          "bucket_name": "acme-uat-silver",
          "uri": "s3://acme-uat-silver"
        },
        "gold": {
          "physical_id": "acme-uat-gold",
          "bucket_name": "acme-uat-gold",
          "uri": "s3://acme-uat-gold"
        }
      },
      "catalog": {
        "logical_name": "iceberg_catalog",
        "implementation": "catalog.aws_glue",
        "catalog_type": "glue",
        "catalog_provider": "aws-glue",
        "catalog_name": "lakehouse_uat",
        "runtime_profile": "aws-glue",
        "physical_id": "123456789012:olf_acme_data_uat",
        "glue_region": "eu-west-3",
        "glue_catalog_id": "123456789012:olf_acme_data_uat",
        "glue_rest_uri": "https://glue.eu-west-3.amazonaws.com/iceberg",
        "glue_rest_warehouse": "123456789012:olf_acme_data_uat",
        "glue_warehouse_prefix": "warehouse/iceberg",
        "catalog_namespace_model": "medallion-owner"
      },
      "query": {
        "service_ref": "shared/query",
        "catalog_ref": "stage/uat/catalog",
        "catalog_name": "lakehouse_uat",
        "endpoint": "http://trino:8080",
        "runtime_identity_ref": "stage/uat/runtime_identity"
      },
      "orchestration": {
        "service_ref": "stage/uat/orchestration",
        "endpoint_ref": "stage/uat/endpoints/orchestration",
        "code_locations": [
          {"name": "openlakeforge-dagster", "definitions_module": "lakehouse_code.definitions"}
        ]
      },
      "reporting": {
        "service_ref": "stage/uat/reporting",
        "endpoint_ref": "stage/uat/endpoints/reporting"
      },
      "governance": {
        "service_ref": "shared/governance_service",
        "endpoint_ref": "stage/uat/endpoints/governance"
      },
      "activation": {
        "ops_storage_ref": "shared/ops_storage",
        "prefix": "activations/uat"
      },
      "endpoints": {
        "catalog": "stage/uat/catalog",
        "query": "shared/query",
        "orchestration": "stage/uat/endpoints/orchestration",
        "reporting": "stage/uat/endpoints/reporting",
        "governance": "stage/uat/endpoints/governance"
      },
      "runtime_identity": {
        "ref": "stage/uat/runtime_identity",
        "principal": "olf-uat-runtime"
      }
    },
    "prod": {
      "namespace": "olf-prod",
      "storage": {
        "provider": "aws",
        "implementation": "storage.aws_s3",
        "protocol": "s3",
        "region": "eu-west-3",
        "identity_ref": "stage/prod/runtime_identity",
        "bronze": {
          "physical_id": "acme-prod-bronze",
          "bucket_name": "acme-prod-bronze",
          "uri": "s3://acme-prod-bronze"
        },
        "silver": {
          "physical_id": "acme-prod-silver",
          "bucket_name": "acme-prod-silver",
          "uri": "s3://acme-prod-silver"
        },
        "gold": {
          "physical_id": "acme-prod-gold",
          "bucket_name": "acme-prod-gold",
          "uri": "s3://acme-prod-gold"
        }
      },
      "catalog": {
        "logical_name": "iceberg_catalog",
        "implementation": "catalog.aws_glue",
        "catalog_type": "glue",
        "catalog_provider": "aws-glue",
        "catalog_name": "lakehouse_prod",
        "runtime_profile": "aws-glue",
        "physical_id": "123456789012",
        "glue_region": "eu-west-3",
        "glue_catalog_id": "123456789012",
        "glue_rest_uri": "https://glue.eu-west-3.amazonaws.com/iceberg",
        "glue_rest_warehouse": "123456789012",
        "glue_warehouse_prefix": "warehouse/iceberg",
        "catalog_namespace_model": "medallion-owner"
      },
      "query": {
        "service_ref": "shared/query",
        "catalog_ref": "stage/prod/catalog",
        "catalog_name": "lakehouse_prod",
        "endpoint": "http://trino:8080",
        "runtime_identity_ref": "stage/prod/runtime_identity"
      },
      "orchestration": {
        "service_ref": "stage/prod/orchestration",
        "endpoint_ref": "stage/prod/endpoints/orchestration",
        "code_locations": [
          {"name": "openlakeforge-dagster", "definitions_module": "lakehouse_code.definitions"}
        ]
      },
      "reporting": {
        "service_ref": "stage/prod/reporting",
        "endpoint_ref": "stage/prod/endpoints/reporting"
      },
      "activation": {
        "ops_storage_ref": "shared/ops_storage",
        "prefix": "activations/prod"
      },
      "endpoints": {
        "catalog": "stage/prod/catalog",
        "query": "shared/query",
        "orchestration": "stage/prod/endpoints/orchestration",
        "reporting": "stage/prod/endpoints/reporting"
      },
      "runtime_identity": {
        "ref": "stage/prod/runtime_identity",
        "principal": "olf-prod-runtime"
      }
    }
  }
}
