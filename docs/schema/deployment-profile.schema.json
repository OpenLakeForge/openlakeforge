{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openlakeforge.io/schemas/deployment-profile/v1alpha1",
  "title": "OpenLakeForge Deployment Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "openlakeforge.io/v1alpha1"},
    "kind": {"const": "DeploymentProfile"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z]([a-z0-9-]{0,61}[a-z0-9])?$"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "preset", "stages"],
      "properties": {
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": {"enum": ["local", "aws", "azure"]},
            "region": {"type": "string", "minLength": 1}
          }
        },
        "preset": {"enum": ["slim", "full"]},
        "access": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "base_domain": {
              "type": "string",
              "default": "olf.localhost",
              "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$"
            },
            "issuer": {
              "type": "string",
              "default": "local-ca",
              "pattern": "^[a-z]([a-z0-9-]{0,61}[a-z0-9])?$"
            }
          }
        },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "issuer": {"enum": ["keycloak", "external"], "default": "keycloak"},
            "issuer_url": {"type": "string", "pattern": "^https://", "description": "Loose check; the olf Python validator (_oidc_issuer_url) is the authority."},
            "role_claim": {"type": "string", "minLength": 1},
            "client_ids": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {"enum": ["perimeter", "superset", "openmetadata", "trino"]},
              "additionalProperties": {"type": "string", "minLength": 1}
            },
            "smtp": {
              "type": "object",
              "additionalProperties": false,
              "required": ["host", "port", "from_address"],
              "description": "Outbound mail for the Keycloak issuer. Non-secret settings only; the login is a Secret reference (docs/setup/identity-secret-rotation.md).",
              "properties": {
                "host": {"type": "string", "pattern": "^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?(\\.[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*$", "maxLength": 253},
                "port": {"type": "integer", "minimum": 1, "maximum": 65535},
                "from_address": {"type": "string", "pattern": "^[^@\\s<>,;\"]+@[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$"},
                "from_name": {"type": "string", "minLength": 1, "maxLength": 100},
                "security": {"enum": ["none", "starttls", "ssl"], "default": "starttls"},
                "auth": {"type": "boolean", "default": false},
                "credentials_secret_ref": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name"],
                  "properties": {
                    "name": {"type": "string", "maxLength": 253, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"},
                    "username_key": {"type": "string", "maxLength": 253, "pattern": "^[-._a-zA-Z0-9]+$", "default": "username"},
                    "password_key": {"type": "string", "maxLength": 253, "pattern": "^[-._a-zA-Z0-9]+$", "default": "password"}
                  }
                }
              },
              "if": {"properties": {"auth": {"const": true}}, "required": ["auth"]},
              "then": {"required": ["credentials_secret_ref"], "properties": {"security": {"enum": ["starttls", "ssl"]}}},
              "else": {"not": {"required": ["credentials_secret_ref"]}}
            },
            "role_mapping": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {"enum": ["platform-admin", "data-engineer", "analyst", "viewer"]},
              "additionalProperties": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              }
            }
          },
          "if": {"properties": {"issuer": {"const": "external"}}, "required": ["issuer"]},
          "then": {"required": ["issuer_url", "role_claim", "role_mapping"]},
          "else": {"not": {"anyOf": [{"required": ["client_ids"]}, {"required": ["smtp"]}]}}
        },
        "stages": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "dev": {"$ref": "#/$defs/stage"},
            "uat": {"$ref": "#/$defs/stage"},
            "prod": {"$ref": "#/$defs/stage"}
          }
        }
      }
    }
  },
  "$defs": {
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "analytics": {"type": "boolean"},
            "governance": {"type": "boolean"}
          }
        }
      }
    }
  }
}
