{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openlakeforge.io/schemas/alert-policy/v1beta1",
  "title": "OpenLakeForge AlertPolicy",
  "description": "Which conditions alert for which products and stages, with which thresholds, and through which routes (ADR 0023, alert policy). A route names a receiver of the Deployment Profile; receivers and their credentials are never declared here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "routes", "rules"],
  "$defs": {
    "stages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["dev", "uat", "prod"]}
    },
    "name": {"type": "string", "pattern": "^[a-z]([a-z0-9-]{0,61}[a-z0-9])?$"},
    "routeList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/name"}
    },
    "duration": {"type": "string", "pattern": "^[1-9][0-9]*[mhd]$", "description": "A positive integer with m, h or d: 30m, 26h, 2d."},
    "severity": {"enum": ["warning", "critical"]},
    "selector": {"type": "string", "pattern": "^([a-z][a-z0-9_]*|\\*)$"}
  },
  "properties": {
    "apiVersion": {"const": "openlakeforge.io/v1beta1"},
    "kind": {"const": "AlertPolicy"},
    "routes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/name"},
      "additionalProperties": {"$ref": "#/$defs/name"},
      "description": "Route name to receiver name (spec.observability.alerts.receivers[].name of the profile)."
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stages": {"$ref": "#/$defs/stages"},
        "notify": {"$ref": "#/$defs/routeList"}
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["match", "when"],
        "properties": {
          "match": {
            "type": "object",
            "additionalProperties": false,
            "required": ["domain", "product"],
            "properties": {
              "domain": {"$ref": "#/$defs/selector"},
              "product": {"$ref": "#/$defs/selector"}
            }
          },
          "stages": {"$ref": "#/$defs/stages"},
          "notify": {"$ref": "#/$defs/routeList"},
          "when": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": false,
            "properties": {
              "run_failed": {
                "oneOf": [
                  {"const": false},
                  {"type": "object", "additionalProperties": false, "properties": {"severity": {"$ref": "#/$defs/severity"}}}
                ]
              },
              "missed_run": {
                "oneOf": [
                  {"const": false},
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {"grace": {"$ref": "#/$defs/duration"}, "severity": {"$ref": "#/$defs/severity"}}
                  }
                ]
              },
              "freshness": {
                "oneOf": [
                  {"const": false},
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "warn_after": {"$ref": "#/$defs/duration"},
                      "critical_after": {"$ref": "#/$defs/duration"},
                      "grace": {"$ref": "#/$defs/duration"},
                      "severity": {"$ref": "#/$defs/severity"}
                    },
                    "dependentSchemas": {
                      "warn_after": {"not": {"anyOf": [{"required": ["grace"]}, {"required": ["severity"]}]}},
                      "critical_after": {"not": {"anyOf": [{"required": ["grace"]}, {"required": ["severity"]}]}}
                    }
                  }
                ]
              },
              "quality": {
                "oneOf": [
                  {"const": false},
                  {"type": "object", "additionalProperties": false, "properties": {"on": {"enum": ["warn", "error"]}}}
                ]
              },
              "schedule_mismatch": {
                "oneOf": [
                  {"const": false},
                  {"type": "object", "additionalProperties": false, "properties": {"severity": {"$ref": "#/$defs/severity"}}}
                ]
              }
            }
          }
        }
      }
    }
  }
}
