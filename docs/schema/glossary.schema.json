{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openlakeforge.io/schemas/glossary/v1alpha1",
  "title": "OpenLakeForge Glossary",
  "description": "A business glossary: terms with definitions, synonyms and related terms, versioned in Git at lakehouse_code/glossaries/<name>.yml. A term is referenced as <glossary>.<Term>. Statuses are the OpenMetadata 1.13.6 EntityStatus values.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "name",
    "displayName",
    "description",
    "terms"
  ],
  "properties": {
    "apiVersion": {
      "const": "openlakeforge.io/v1alpha1"
    },
    "kind": {
      "const": "Glossary"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "$ref": "#/$defs/entityRef"
    },
    "terms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/term"
      }
    }
  },
  "$defs": {
    "entityRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "ref"
      ],
      "properties": {
        "type": {
          "enum": [
            "user",
            "team"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "term": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "displayName",
        "description"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "synonyms": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "enum": [
            "Draft",
            "In Review",
            "Approved",
            "Archived",
            "Deprecated",
            "Rejected",
            "Unprocessed"
          ]
        },
        "parent": {
          "description": "Name of another term in this glossary.",
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "relatedTerms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*\\.[A-Za-z][A-Za-z0-9_]*$"
          }
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "endpoint"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "endpoint": {
                "type": "string",
                "pattern": "^https://\\S+$"
              }
            }
          }
        }
      }
    }
  }
}
