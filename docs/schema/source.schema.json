{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openlakeforge.io/schemas/source/v1alpha3",
  "title": "OpenLakeForge Source",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "name", "displayName", "description", "status", "resources"],
  "properties": {
    "apiVersion": {"const": "openlakeforge.io/v1alpha3"},
    "kind": {"const": "Source"},
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "displayName": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "status": {"type": "string", "minLength": 1},
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "description": {"type": "string"}
        }
      }
    },
    "runtime": {
      "description": "Names of the settings and credentials the source's loader reads. Each stage binds the values in its own ConfigMap and Secret; never put a value here.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "config": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"}},
        "secrets": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"}}
      }
    }
  }
}