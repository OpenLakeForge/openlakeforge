    "/api/v1/stages/{stage}/logs": {
      "get": {
        "description": "The stage's archived pod log lines for a day or one hour of it, oldest archive first.",
        "operationId": "list_logs_api_v1_stages__stage__logs_get",
        "parameters": [
          {
            "in": "path",
            "name": "stage",
            "required": true,
            "schema": {
              "title": "Stage",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "date",
            "required": true,
            "schema": {
              "format": "date",
              "title": "Date",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "hour",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 23,
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Hour"
            }
          },
          {
            "in": "query",
            "name": "pod",
            "required": false,
            "schema": {
              "default": "",
              "title": "Pod",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "container",
            "required": false,
            "schema": {
              "default": "",
              "title": "Container",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 500,
              "maximum": 5000,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Logs"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Logs"
      }
    },
