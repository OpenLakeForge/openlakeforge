{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openlakeforge.io/schemas/governance/v1beta1",
  "title": "OpenLakeForge Governance",
  "description": "Business domains and the data products that name them. Tables belong to a domain or product by schema (<domain>_silver, <product>_gold) and are not declared here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "domains", "products"],
  "properties": {
    "apiVersion": {"const": "openlakeforge.io/v1beta1"},
    "kind": {"const": "Governance"},
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "displayName"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "displayName": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "status": {"type": "string", "minLength": 1}
        }
      }
    },
    "products": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "domain", "displayName"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "domain": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "displayName": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "status": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
