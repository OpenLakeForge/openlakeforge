{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openlakeforge.io/schemas/governance/v1beta2",
  "title": "OpenLakeForge Governance",
  "description": "Business domains and the data products nested under them. A product belongs to the domain it is declared in. Tables belong to a domain or product by schema (<domain>_silver, <product>_gold) and are not declared here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "domains"
  ],
  "properties": {
    "apiVersion": {
      "const": "openlakeforge.io/v1beta2"
    },
    "kind": {
      "const": "Governance"
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "displayName"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "displayName": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "products": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "displayName"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "displayName": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string"
                },
                "owner": {
                  "$ref": "#/$defs/entityRef"
                },
                "experts": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/entityRef"
                  }
                },
                "classification": {
                  "enum": [
                    "Public",
                    "Internal",
                    "Confidential",
                    "Restricted"
                  ]
                },
                "reviewers": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/entityRef"
                  }
                },
                "type": {
                  "enum": [
                    "RAW_DATA",
                    "DERIVED_DATA",
                    "DATASET",
                    "REPORTS",
                    "ANALYTIC_VIEW",
                    "VISUALISATION_3D",
                    "ALGORITHM",
                    "DECISION_SUPPORT",
                    "AUTOMATED_DECISION_MAKING",
                    "DATA_ENHANCED_PRODUCT",
                    "DATA_DRIVEN_SERVICE",
                    "DATA_ENABLED_PERFORMANCE",
                    "BI_DIRECTIONAL"
                  ]
                },
                "tier": {
                  "enum": [
                    "Tier1",
                    "Tier2",
                    "Tier3",
                    "Tier4",
                    "Tier5"
                  ]
                },
                "lifecycle": {
                  "enum": [
                    "IDEATION",
                    "DESIGN",
                    "DEVELOPMENT",
                    "TESTING",
                    "PRODUCTION",
                    "DEPRECATED",
                    "RETIRED"
                  ]
                },
                "termsOfUse": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": false,
                  "properties": {
                    "allowed": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "prohibited": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                },
                "glossaryTerms": {
                  "$ref": "#/$defs/glossaryTerms"
                },
                "sla": {
                  "$ref": "#/$defs/productSla"
                }
              }
            }
          },
          "owner": {
            "$ref": "#/$defs/entityRef"
          },
          "experts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/entityRef"
            }
          },
          "classification": {
            "enum": [
              "Public",
              "Internal",
              "Confidential",
              "Restricted"
            ]
          },
          "domainType": {
            "enum": [
              "Source-aligned",
              "Consumer-aligned",
              "Aggregate"
            ]
          },
          "glossaryTerms": {
            "$ref": "#/$defs/glossaryTerms"
          }
        }
      }
    }
  },
  "$defs": {
    "entityRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "ref"
      ],
      "properties": {
        "type": {
          "enum": [
            "user",
            "team"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "glossaryTerms": {
      "description": "Glossary terms that define this entity, as <glossary>.<Term>. Resolved against lakehouse_code/glossaries/*.yml by `olf check contracts`.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*\\.[A-Za-z][A-Za-z0-9_]*$"
      }
    },
    "productSla": {
      "description": "The promise a product owner makes about freshness and availability. Declaring it never implies it is met; observed compliance is reported separately.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tier"
      ],
      "properties": {
        "tier": {
          "enum": [
            "GOLD",
            "SILVER",
            "BRONZE",
            "CUSTOM"
          ],
          "description": "OpenMetadata DataProduct.sla.tier."
        },
        "freshness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maximumAge"
          ],
          "dependentRequired": {
            "readyBy": [
              "timezone"
            ]
          },
          "properties": {
            "maximumAge": {
              "type": "string",
              "pattern": "^P(?!(?:0+W)?(?:0+D)?(?:T(?:0+H)?(?:0+M)?(?:0+S)?)?$)(?=\\d|T\\d)(\\d+W)?(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?(\\d+S)?)?$",
              "description": "Longest acceptable age of the product's data, as an ISO 8601 duration (PT26H). Published as dataFreshness in whole minutes."
            },
            "readyBy": {
              "type": "string",
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
              "description": "Wall-clock HH:MM in `timezone` by which the day's data is ready."
            },
            "timezone": {
              "type": "string",
              "minLength": 1,
              "description": "IANA timezone for readyBy, such as Europe/Paris."
            }
          }
        },
        "availability": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schedule"
          ],
          "properties": {
            "schedule": {
              "type": "string",
              "minLength": 1,
              "description": "Five-field cron expression of when the product is expected to refresh."
            },
            "gracePeriod": {
              "type": "string",
              "pattern": "^P(?!(?:0+W)?(?:0+D)?(?:T(?:0+H)?(?:0+M)?(?:0+S)?)?$)(?=\\d|T\\d)(\\d+W)?(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?(\\d+S)?)?$",
              "description": "How long after a scheduled time the refresh may still arrive."
            }
          }
        },
        "minimumQualityScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Percent of passing quality checks. Published as dataQuality."
        }
      }
    }
  }
}
