{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenLakeForge Provider Contracts v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "deployment", "shared", "stages"],
  "properties": {
    "schema_version": {"const": "3.0.0"},
    "deployment": {"$ref": "#/definitions/deployment"},
    "shared": {"$ref": "#/definitions/shared"},
    "stages": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "dev": {"$ref": "#/definitions/stage"},
        "uat": {"$ref": "#/definitions/stage"},
        "prod": {"$ref": "#/definitions/stage"}
      }
    }
  },
  "definitions": {
    "nonEmptyString": {"type": "string", "minLength": 1},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "implementation"],
      "properties": {
        "ref": {"$ref": "#/definitions/nonEmptyString"},
        "implementation": {"$ref": "#/definitions/nonEmptyString"},
        "endpoint": {"$ref": "#/definitions/nonEmptyString"},
        "bucket_name": {"$ref": "#/definitions/nonEmptyString"},
        "artifact_base_uri": {"$ref": "#/definitions/nonEmptyString"},
        "access_mode": {"$ref": "#/definitions/nonEmptyString"},
        "local_upload_access_mode": {"$ref": "#/definitions/nonEmptyString"}
      }
    },
    "oidcClient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["client_id", "secret_ref"],
      "properties": {
        "client_id": {"$ref": "#/definitions/nonEmptyString"},
        "secret_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "key"],
          "properties": {
            "name": {"$ref": "#/definitions/nonEmptyString"},
            "key": {"$ref": "#/definitions/nonEmptyString"}
          }
        }
      }
    },
    "identityBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "implementation", "roles"],
      "if": {"properties": {"implementation": {"const": "identity.oidc"}}},
      "then": {"required": ["issuer_url", "role_claim", "role_mapping", "clients"]},
      "else": {"not": {"anyOf": [
        {"required": ["adapter"]}, {"required": ["provider"]}, {"required": ["capabilities"]},
        {"required": ["issuer_url"]}, {"required": ["role_claim"]},
        {"required": ["role_mapping"]}, {"required": ["clients"]}
      ]}},
      "properties": {
        "ref": {"$ref": "#/definitions/nonEmptyString"},
        "implementation": {"$ref": "#/definitions/nonEmptyString"},
        "adapter": {"$ref": "#/definitions/nonEmptyString"},
        "provider": {"type": "object"},
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "admin_api": {"type": "boolean"},
            "groups_in_token": {"type": "boolean"},
            "logout_endpoint": {"type": "boolean"}
          }
        },
        "issuer_url": {"type": "string", "pattern": "^https://"},
        "role_claim": {"$ref": "#/definitions/nonEmptyString"},
        "role_mapping": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"$ref": "#/definitions/nonEmptyString"}
          }
        },
        "clients": {
          "type": "object",
          "additionalProperties": false,
          "required": ["perimeter", "superset", "openmetadata", "trino"],
          "properties": {
            "perimeter": {"$ref": "#/definitions/oidcClient"},
            "superset": {"$ref": "#/definitions/oidcClient"},
            "openmetadata": {"$ref": "#/definitions/oidcClient"},
            "trino": {"$ref": "#/definitions/oidcClient"}
          }
        },
        "roles": {
          "type": "object",
          "additionalProperties": false,
          "required": ["precedence", "grants"],
          "properties": {
            "precedence": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"$ref": "#/definitions/nonEmptyString"}
            },
            "grants": {
              "type": "object",
              "propertyNames": {"enum": ["orchestration", "reporting", "governance_service", "query"]},
              "additionalProperties": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {"$ref": "#/definitions/nonEmptyString"}
              }
            }
          }
        }
      }
    },
    "accessBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "implementation"],
      "dependentRequired": {
        "base_domain": ["issuer", "tls_mode", "routes"],
        "issuer": ["base_domain"],
        "tls_mode": ["base_domain"],
        "routes": ["base_domain"]
      },
      "if": {"properties": {"implementation": {"const": "access.ingress"}}},
      "then": {"required": ["base_domain", "issuer", "tls_mode", "routes"]},
      "properties": {
        "ref": {"$ref": "#/definitions/nonEmptyString"},
        "implementation": {"$ref": "#/definitions/nonEmptyString"},
        "base_domain": {"$ref": "#/definitions/nonEmptyString"},
        "issuer": {"$ref": "#/definitions/nonEmptyString"},
        "tls_mode": {"enum": ["ingress-terminated"]},
        "routes": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["url", "enabled", "exposure"],
            "properties": {
              "url": {"type": "string", "pattern": "^https://"},
              "enabled": {"type": "boolean"},
              "exposure": {"enum": ["user-facing", "internal"]}
            }
          }
        }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_name", "provider", "region"],
      "properties": {
        "profile_name": {"$ref": "#/definitions/nonEmptyString"},
        "provider": {"enum": ["local", "aws", "azure"]},
        "region": {"type": ["string", "null"]}
      }
    },
    "shared": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "foundation",
        "kubernetes_platform",
        "metadata_database",
        "query",
        "artifact_registry",
        "ops_storage",
        "secrets",
        "identity",
        "access",
        "observability"
      ],
      "properties": {
        "foundation": {"$ref": "#/definitions/binding"},
        "kubernetes_platform": {"$ref": "#/definitions/binding"},
        "metadata_database": {"$ref": "#/definitions/binding"},
        "query": {"$ref": "#/definitions/binding"},
        "artifact_registry": {"$ref": "#/definitions/binding"},
        "ops_storage": {"$ref": "#/definitions/binding"},
        "secrets": {"$ref": "#/definitions/binding"},
        "identity": {"$ref": "#/definitions/identityBinding"},
        "access": {"$ref": "#/definitions/accessBinding"},
        "observability": {"$ref": "#/definitions/binding"},
        "catalog_service": {"$ref": "#/definitions/binding"},
        "governance_service": {"$ref": "#/definitions/binding"}
      }
    },
    "layerStorage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["physical_id", "bucket_name", "uri"],
      "properties": {
        "physical_id": {"$ref": "#/definitions/nonEmptyString"},
        "bucket_name": {"$ref": "#/definitions/nonEmptyString"},
        "uri": {"type": "string"}
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "implementation",
        "protocol",
        "region",
        "identity_ref",
        "bronze",
        "silver",
        "gold"
      ],
      "properties": {
        "provider": {"enum": ["local", "aws", "azure"]},
        "implementation": {"$ref": "#/definitions/nonEmptyString"},
        "protocol": {"$ref": "#/definitions/nonEmptyString"},
        "region": {"$ref": "#/definitions/nonEmptyString"},
        "identity_ref": {"$ref": "#/definitions/nonEmptyString"},
        "endpoint": {"type": "string"},
        "virtual_host_endpoint": {"type": "string"},
        "path_style_access": {"type": "boolean"},
        "ssl_mode": {"$ref": "#/definitions/nonEmptyString"},
        "credentials_secret_name": {"type": "string"},
        "access_key_id_key": {"type": "string"},
        "secret_access_key_key": {"type": "string"},
        "s3_service_name": {"type": "string"},
        "s3_service_port": {"type": ["integer", "string"]},
        "bronze": {"$ref": "#/definitions/layerStorage"},
        "silver": {"$ref": "#/definitions/layerStorage"},
        "gold": {"$ref": "#/definitions/layerStorage"}
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logical_name",
        "implementation",
        "catalog_type",
        "catalog_provider",
        "catalog_name",
        "runtime_profile",
        "physical_id"
      ],
      "properties": {
        "logical_name": {"$ref": "#/definitions/nonEmptyString"},
        "implementation": {"$ref": "#/definitions/nonEmptyString"},
        "catalog_type": {"enum": ["rest", "glue"]},
        "catalog_provider": {"enum": ["polaris", "aws-glue"]},
        "catalog_name": {"$ref": "#/definitions/nonEmptyString"},
        "runtime_profile": {"$ref": "#/definitions/nonEmptyString"},
        "physical_id": {"$ref": "#/definitions/nonEmptyString"},
        "service_ref": {"$ref": "#/definitions/nonEmptyString"},
        "warehouse": {"type": "string"},
        "rest_uri": {"type": "string"},
        "token_uri": {"type": "string"},
        "oauth_scope": {"type": "string"},
        "glue_region": {"type": "string"},
        "glue_catalog_id": {"type": "string"},
        "glue_rest_uri": {"type": "string"},
        "glue_rest_warehouse": {"type": "string"},
        "glue_warehouse_prefix": {"type": "string"},
        "catalog_namespace_model": {"type": "string"},
        "floe_credentials_secret_name": {"type": "string"},
        "floe_client_id_key": {"type": "string"},
        "floe_client_secret_key": {"type": "string"},
        "deployer_credentials_secret_name": {"type": "string"},
        "deployer_client_id_key": {"type": "string"},
        "deployer_client_secret_key": {"type": "string"}
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service_ref", "catalog_ref", "catalog_name", "endpoint", "runtime_identity_ref"],
      "properties": {
        "service_ref": {"$ref": "#/definitions/nonEmptyString"},
        "catalog_ref": {"$ref": "#/definitions/nonEmptyString"},
        "catalog_name": {"$ref": "#/definitions/nonEmptyString"},
        "endpoint": {"$ref": "#/definitions/nonEmptyString"},
        "runtime_identity_ref": {"$ref": "#/definitions/nonEmptyString"}
      }
    },
    "serviceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service_ref", "endpoint_ref"],
      "properties": {
        "service_ref": {"$ref": "#/definitions/nonEmptyString"},
        "endpoint_ref": {"$ref": "#/definitions/nonEmptyString"}
      }
    },
    "orchestrationBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service_ref", "endpoint_ref"],
      "properties": {
        "service_ref": {"$ref": "#/definitions/nonEmptyString"},
        "endpoint_ref": {"$ref": "#/definitions/nonEmptyString"},
        "pipeline_service_name": {"$ref": "#/definitions/nonEmptyString"},
        "code_locations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "definitions_module"],
            "properties": {
              "name": {"$ref": "#/definitions/nonEmptyString"},
              "definitions_module": {"$ref": "#/definitions/nonEmptyString"}
            }
          }
        }
      }
    },
    "reportingBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service_ref", "endpoint_ref"],
      "properties": {
        "service_ref": {"$ref": "#/definitions/nonEmptyString"},
        "endpoint_ref": {"$ref": "#/definitions/nonEmptyString"},
        "dashboard_service_name": {"$ref": "#/definitions/nonEmptyString"}
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "storage",
        "catalog",
        "query",
        "orchestration",
        "activation",
        "endpoints",
        "runtime_identity"
      ],
      "properties": {
        "namespace": {"$ref": "#/definitions/nonEmptyString"},
        "storage": {"$ref": "#/definitions/storage"},
        "catalog": {"$ref": "#/definitions/catalog"},
        "query": {"$ref": "#/definitions/query"},
        "orchestration": {"$ref": "#/definitions/orchestrationBinding"},
        "reporting": {"$ref": "#/definitions/reportingBinding"},
        "governance": {"$ref": "#/definitions/serviceBinding"},
        "activation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ops_storage_ref", "prefix"],
          "properties": {
            "ops_storage_ref": {"$ref": "#/definitions/nonEmptyString"},
            "prefix": {"$ref": "#/definitions/nonEmptyString"}
          }
        },
        "endpoints": {
          "type": "object",
          "additionalProperties": false,
          "required": ["catalog", "query", "orchestration"],
          "properties": {
            "catalog": {"$ref": "#/definitions/nonEmptyString"},
            "query": {"$ref": "#/definitions/nonEmptyString"},
            "orchestration": {"$ref": "#/definitions/nonEmptyString"},
            "reporting": {"$ref": "#/definitions/nonEmptyString"},
            "governance": {"$ref": "#/definitions/nonEmptyString"}
          }
        },
        "runtime_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ref", "principal"],
          "properties": {
            "ref": {"$ref": "#/definitions/nonEmptyString"},
            "principal": {"$ref": "#/definitions/nonEmptyString"}
          }
        }
      }
    }
  }
}
